#!/usr/bin/env bash
# dnscheck — compare configured DNS resolvers against a public resolver
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/netpack.sh
source "${ROOT}/lib/netpack.sh"
# shellcheck source=../lib/netpack/parsers.sh
source "${ROOT}/lib/netpack/parsers.sh"

NAME="cloudflare.com"
PUBLIC=""
TYPE="A"
IFACE=""

# Baseline candidates, preferred first. The default baseline is chosen at run
# time as the first of these the system is not already using: a baseline drawn
# from the configured set is not a control, and on a host that forwards to
# 1.1.1.1 a fixed default would compare that resolver against itself and read
# as agreement. Cloudflare, Quad9, Google, OpenDNS.
PUBLIC_CANDIDATES=(1.1.1.1 9.9.9.9 8.8.8.8 208.67.222.222)

usage() {
  cat <<'EOF'
dnscheck — compare system-configured DNS resolvers with a public resolver.

Queries the same name via each configured resolver and one public resolver.
Reports RCODE, addresses, and query time. Disagreement or failure often
explains "network is down" when ICMP still works.

Resolvers come from `resolvectl dns` when systemd-resolved is running, so the
real per-link upstreams are tested rather than the 127.0.0.53 stub that
/etc/resolv.conf advertises; without resolved, resolv.conf is used directly.
When only a loopback stub can be identified, the run says so and exits 2 — a
stub proves nothing about the servers it forwards to.

Generates a small number of DNS queries.

On a multi-homed machine, -i binds the queries to IFACE's address so a chosen
uplink's resolver reachability is tested instead of the default route's. The
baseline resolver is off-link, so the run needs a policy route (ip rule)
steering that address out IFACE; without one it exits 1 rather than reporting
rp_filter drops as resolver failure.

Usage:
  dnscheck [-i IFACE] [-n NAME] [-p PUBLIC_RESOLVER] [-t TYPE]

Options:
  -i IFACE             Bind queries to IFACE's address (multi-homed)
  -n NAME              Query name (default: cloudflare.com)
  -p PUBLIC_RESOLVER   Public resolver for baseline (default: auto-chosen; see below)
  -t TYPE              Record type: mnemonic or TYPEn (default: A)
  -h, --help           Show this help

Note: names with geo or round-robin answers (CDNs) can differ legitimately
across resolvers. Prefer stable names (the default) for hijack checks.

The baseline defaults to the first of 1.1.1.1, 9.9.9.9, 8.8.8.8, 208.67.222.222
that the system is not already using, so it is a genuine control rather than one
of the configured resolvers compared against itself. An explicit -p is used as
given; if it is also configured, the run says so, since agreement with itself is
not evidence.

Exit codes:
  0  at least two distinct resolvers agreed and succeeded
  1  usage or dependency error; or -i could not bind an honest probe
  2  a resolver failed, no upstreams could be identified, or there was
     nothing independent to compare against
  3  resolvers returned conflicting answers
EOF
}

PUBLIC_EXPLICIT=0

if [[ "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

while getopts ":i:n:p:t:h" opt; do
  case "$opt" in
    i) IFACE=$OPTARG ;;
    n) NAME=$OPTARG ;;
    p) PUBLIC=$OPTARG; PUBLIC_EXPLICIT=1 ;;
    t) TYPE=$OPTARG ;;
    h) usage; exit 0 ;;
    *) usage >&2; exit 1 ;;
  esac
done
shift $((OPTIND - 1))
no_extra_args "$@"

TYPE="${TYPE^^}"  # dig prints record types uppercase
if ! is_dns_rrtype "$TYPE"; then
  die "invalid record type: ${TYPE} (use a mnemonic like A, AAAA, MX, TXT, or TYPEn)"
fi

require_cmd dig awk sort

# Fill RESOLVERS with "label<TAB>server" rows and describe where they came from.
# Assigns globals rather than printing, because command substitution would run
# this in a subshell and lose RESOLVER_SOURCE / STUB_ONLY.
RESOLVERS=()
RESOLVER_SOURCE=""
STUB_ONLY=0
discover_resolvers() {
  RESOLVERS=()
  RESOLVER_SOURCE=""
  STUB_ONLY=0
  local rows="" srv all_stub=1

  # resolved's stub in resolv.conf hides the real upstreams; ask resolved itself.
  if command -v resolvectl >/dev/null 2>&1; then
    # SC2119: the parsers take an optional file and read stdin without one,
    # which is the form wanted here.
    # shellcheck disable=SC2119
    rows="$(resolvectl dns 2>/dev/null | parse_resolvectl_dns | dedupe_by_value)" || rows=""
    if [[ -n "$rows" ]]; then
      RESOLVER_SOURCE="resolvectl (systemd-resolved upstreams)"
      mapfile -t RESOLVERS <<<"$rows"
      return 0
    fi
  fi

  if [[ -r /etc/resolv.conf ]]; then
    rows="$(parse_resolv_conf /etc/resolv.conf \
      | awk '{ print "resolv.conf\t" $0 }' | dedupe_by_value)" || rows=""
  fi
  [[ -n "$rows" ]] || return 1

  RESOLVER_SOURCE="/etc/resolv.conf"
  while IFS=$'\t' read -r _ srv; do
    [[ -n "$srv" ]] || continue
    is_stub_addr "$srv" || all_stub=0
  done <<<"$rows"
  # Every entry is loopback: a forwarding stub whose upstreams we cannot see.
  if (( all_stub )); then
    STUB_ONLY=1
    RESOLVER_SOURCE="/etc/resolv.conf (local stub only — upstreams not visible)"
  fi
  mapfile -t RESOLVERS <<<"$rows"
}

query_one() {
  local server=$1
  local out status addrs rtt
  # One dig so status, answers, and RTT come from the same transaction.
  out="$(dig "${DIG_BIND[@]+"${DIG_BIND[@]}"}" @"$server" "$NAME" "$TYPE" +time=2 +tries=1 +noall +answer +comments +stats 2>/dev/null || true)"
  status="$(printf '%s\n' "$out" | awk '/status:/ {
    for (i=1;i<=NF;i++) if ($i=="status:") { gsub(/,/,"",$(i+1)); print $(i+1); exit }
  }')"
  addrs="$(printf '%s\n' "$out" | awk -v t="$TYPE" '
    $4 == t {
      # Keep full rdata (MX priority+host, multi-field TXT, ...)
      rdata = $5
      for (i = 6; i <= NF; i++) rdata = rdata " " $i
      print rdata
    }
  ' | sort -u | tr '\n' ',' | sed 's/,$//')"
  rtt="$(printf '%s\n' "$out" | awk '/Query time:/ {print $4; exit}')"
  if [[ -z "${status:-}" ]]; then
    status="FAIL"
  fi
  if [[ -z "${addrs:-}" ]]; then
    addrs="-"
  fi
  if [[ -z "${rtt:-}" ]]; then
    rtt="-"
  else
    rtt="${rtt}ms"
  fi
  printf '%s\t%s\t%s\t%s\n' "$server" "$status" "$addrs" "$rtt"
}

header dnscheck
echo "name: ${NAME}  type: ${TYPE}"

discover_resolvers || true
if (( ${#RESOLVERS[@]} == 0 )); then
  RESOLVER_SOURCE="none found (checked resolvectl and /etc/resolv.conf)"
fi
echo "resolvers: ${RESOLVER_SOURCE}"

# True when SERVER is one of the configured resolvers.
is_configured() {
  local want=$1 row
  for row in "${RESOLVERS[@]+"${RESOLVERS[@]}"}"; do
    [[ "${row#*$'\t'}" == "$want" ]] && return 0
  done
  return 1
}

# Choose the baseline unless -p pinned one: the first candidate the system is
# not already using, so the control is independent by construction.
if (( ! PUBLIC_EXPLICIT )); then
  for candidate in "${PUBLIC_CANDIDATES[@]}"; do
    if ! is_configured "$candidate"; then
      PUBLIC=$candidate
      break
    fi
  done
  # Every candidate is configured: rare, but do not silently pick a duplicate.
  [[ -n "$PUBLIC" ]] || PUBLIC=${PUBLIC_CANDIDATES[0]}
fi

BASELINE_SHARED=0
if is_configured "$PUBLIC"; then
  BASELINE_SHARED=1
fi

# The baseline is off-link by construction, so it is what the binding must be
# able to reach; a configured resolver on IFACE's own subnet stays reachable
# either way.
DIG_BIND=()
if [[ -n "$IFACE" ]]; then
  SRC="$(require_uplink "$IFACE" "$PUBLIC")"
  DIG_BIND=(-b "$SRC")
fi

# The resolver rows above are already labeled per link; this names the egress
# for the queries themselves on a multi-homed box.
if [[ -n "$IFACE" ]]; then
  multihomed_note "${IFACE} (bound with -i)"
else
  multihomed_note "$(via_for "$PUBLIC")" "pass -i IFACE to test another uplink"
fi

QUERY_ROWS=("${RESOLVERS[@]+"${RESOLVERS[@]}"}")
if (( ! BASELINE_SHARED )); then
  QUERY_ROWS+=("public"$'\t'"$PUBLIC")
fi

echo
echo "=== queries ==="
printf '%-16s %-12s %-10s %-32s %s\n' "resolver" "via" "status" "answers" "rtt"
declare -a ANSWERS=()
declare -a STATUSES=()

for row in "${QUERY_ROWS[@]}"; do
  via="${row%%$'\t'*}"
  s="${row#*$'\t'}"
  IFS=$'\t' read -r srv status addrs rtt <<<"$(query_one "$s")"
  # Pad to the header's 10-char status column before coloring; ANSI codes
  # would defeat printf's field width.
  status_pad="$(printf '%-10s' "$status")"
  case "$status" in
    NOERROR) status_disp="$(color_status ok "$status_pad")" ;;
    FAIL)    status_disp="$(color_status bad "$status_pad")" ;;
    *)       status_disp="$(color_status warn "$status_pad")" ;;
  esac
  printf '%-16s %-12s %s %-32s %s\n' "$srv" "$via" "$status_disp" "$addrs" "$rtt"
  STATUSES+=("$status")
  ANSWERS+=("$addrs")
done

# Compare: any FAIL / non-NOERROR -> fail; conflicting answer sets among NOERROR -> conflict
failed=0
declare -a ok_answers=()
for i in "${!STATUSES[@]}"; do
  st="${STATUSES[$i]}"
  if [[ "$st" != "NOERROR" ]]; then
    failed=1
    continue
  fi
  ok_answers+=("${ANSWERS[$i]}")
done

conflict=0
if [[ ${#ok_answers[@]} -ge 2 ]]; then
  first="${ok_answers[0]}"
  for a in "${ok_answers[@]}"; do
    if [[ "$a" != "$first" ]]; then
      conflict=1
      break
    fi
  done
fi

if (( BASELINE_SHARED )); then
  echo
  warning "baseline ${PUBLIC} is also a configured resolver, so it is not an independent control"
fi

if (( failed )); then
  verdict "one or more resolvers failed or returned a non-NOERROR status." \
    "Check resolver reachability, captive portals, and local DNS configuration."
  finished
  exit 2
fi
if (( conflict )); then
  verdict "resolvers returned conflicting answers for the same name." \
    "Compare configured resolvers against the public baseline; suspect hijack, split DNS, or stale cache."
  finished
  exit 3
fi
if (( ${#RESOLVERS[@]} == 0 )); then
  verdict "public resolver succeeded; no configured resolvers were found." \
    "Inspect /etc/resolv.conf or systemd-resolved configuration."
  finished
  exit 2
fi
if (( STUB_ONLY )); then
  verdict "only a local forwarding stub answered; the upstreams it forwards to were not tested." \
    "A stub agreeing with the baseline proves nothing about its upstreams — query them directly with -p."
  finished
  exit 2
fi
# Agreement is only evidence when two different servers produced it. One server
# queried once (or labelled twice) has nothing to agree with.
if (( ${#QUERY_ROWS[@]} < 2 )); then
  verdict "only one resolver was available, so there was nothing to compare it against." \
    "Pass -p with a resolver this system does not use to get an independent baseline."
  finished
  exit 2
fi
if (( BASELINE_SHARED )); then
  verdict "${#QUERY_ROWS[@]} configured resolvers agree, but the baseline was not independent of them." \
    "They cross-check each other; for a true control, re-run with -p set to a resolver the system does not use."
else
  verdict "configured and public resolvers returned consistent NOERROR answers."
fi
finished
exit 0
