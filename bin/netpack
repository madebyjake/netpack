#!/usr/bin/env bash
# netpack — launcher for network field tools
set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Resolve symlinks when installed on PATH
if command -v readlink >/dev/null 2>&1; then
  if resolved="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null)"; then
    BIN_DIR="$(cd "$(dirname "$resolved")" && pwd)"
  fi
fi

# Menu sections: "Title:tool tool ...". Single source of truth for both the
# tool list and the menu numbering, so numbers stay stable as long as new tools
# are appended within their section.
SECTIONS=(
  "Segment & link:dhcpprobe linkstat cabletest segscan wifiscan discover"
  "Reachability & path:splitloss dnscheck webcheck portcheck mtucheck path3 udp-loss"
  "Streams & capture:mcastcheck ringcap"
  "Throughput — planned tests only:testsrv testcli"
)

TOOLS=()
_section_tools=()
for _section in "${SECTIONS[@]}"; do
  read -r -a _section_tools <<<"${_section#*:}"
  TOOLS+=("${_section_tools[@]}")
done
# doctor is keyed 'd' in the menu rather than numbered, so it sits outside the
# sections but is still a runnable tool name.
TOOLS+=(doctor)
unset _section _section_tools

# Tool metadata (root/traffic/description/impact) is shared with bin/doctor.
# shellcheck source=../lib/netpack/tools.sh
if ! source "${BIN_DIR}/../lib/netpack/tools.sh"; then
  echo "error: cannot load ${BIN_DIR}/../lib/netpack/tools.sh" >&2
  exit 1
fi

# Guided playbooks. Sourced after tools.sh, whose trim() it reuses.
# shellcheck source=../lib/netpack/playbooks.sh
if ! source "${BIN_DIR}/../lib/netpack/playbooks.sh"; then
  echo "error: cannot load ${BIN_DIR}/../lib/netpack/playbooks.sh" >&2
  exit 1
fi

# Menu splash animation. Uses the palette below, which it reads at play time.
# shellcheck source=../lib/netpack/animate.sh
if ! source "${BIN_DIR}/../lib/netpack/animate.sh"; then
  echo "error: cannot load ${BIN_DIR}/../lib/netpack/animate.sh" >&2
  exit 1
fi

# Snapshot any inherited LINES up front: bash's checkwinsize can rewrite it
# between commands, which would make the menu layout flicker between draws.
NP_LINES=${LINES:-}

# Amber heading/[note], red [warn], blue root, green ok; honor NO_COLOR / non-TTY.
C_AMBER='' C_BOLD='' C_DIM='' C_WARN='' C_ROOT='' C_OK='' C_OFF=''
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  C_AMBER=$'\033[38;5;214m'
  C_BOLD=$'\033[1m'
  C_DIM=$'\033[2m'
  C_WARN=$'\033[31m'
  C_ROOT=$'\033[34m'
  C_OK=$'\033[32m'
  C_OFF=$'\033[0m'
fi

netpack_version() {
  local init="${BIN_DIR}/../lib/netpack/__init__.py"
  if [[ -f "$init" ]]; then
    sed -n 's/^__version__ = "\(.*\)"/\1/p' "$init" | head -1
  else
    # Matches lib/netpack.sh netpack_version when the Python lib is missing.
    echo "unknown"
  fi
}

usage() {
  local me t
  me="$(basename "${BASH_SOURCE[0]}")"
  cat <<EOF
netpack — network field tools

Usage:
  ${me}                 Interactive menu
  ${me} list            List tools
  ${me} help            Show this help
  ${me} --version       Print version
  ${me} <tool> [args]   Run a tool (arguments pass through)
  ${me} playbooks       List guided playbooks
  ${me} playbook <id>   Run a guided playbook
  ${me} -o DIR ...      Capture evidence into DIR (menu or single tool)

Also available as: netpack | npk

Tools:
EOF
  for t in "${TOOLS[@]}"; do
    tool_row "" "$t"
  done
  echo
  print_legend
  # Unquoted: the capture examples below interpolate the invoked name.
  cat <<EOF

Menu keys:
  N | <tool>           Run by number or by name
  N <args>             Run with arguments, skipping the prompts (e.g. 2 -t 30)
  ?N | ?<tool>         Show that tool's --help
  d                    doctor
  r                    Repeat the previous run
  q | Ctrl-D           Quit

Options:
  -h, --help, help     Show this help
  -V, --version        Print version
  -o, --out DIR        Capture evidence into DIR
  list, ls             List tools

Evidence capture:
  ${me} -o DIR                 Menu; every run is captured into DIR
  ${me} -o DIR <tool> [args]   Capture one run

  Each run writes DIR/<tool>-<timestamp>.log (the terminal report, plus stderr,
  in plain text) and appends a row to DIR/manifest.tsv recording the command,
  its start and end times, and its exit code. This is how tools without their
  own --dump still leave evidence; tools that do write JSON still do.

  Only runs started through the launcher are captured. Invoking a tool directly
  by name bypasses it, so drive an evidence session through ${me}.

Tools are also available directly from this directory when it is on PATH.
EOF
}

# Tag legend, shared by help, list and menu.
print_legend() {
  printf '  %ssudo%s   needs root (auto-elevates)\n' "$C_ROOT" "$C_OFF"
  printf '  %ssudo?%s  better with root (asks at launch)\n' "$C_DIM" "$C_OFF"
  printf '  %sprobe%s  sends light diagnostic traffic\n' "$C_AMBER" "$C_OFF"
  printf '  %sloud%s   heavy traffic, probing, or link disruption — planned use only\n' \
    "$C_WARN" "$C_OFF"
}

# One tool row. NUM may be a number, a letter key, or empty for `list`.
# sudo column: 'sudo' (blue) = root required, 'sudo?' (dim) = asks at launch.
tool_row() {
  local num=$1 name=$2
  local sudo_txt='' c_sudo='' traffic c_traffic=''
  # The table stores the tags exactly as rendered; only the color is derived.
  sudo_txt="${TOOL_ROOT[$name]:-}"
  case "$sudo_txt" in
    sudo)    c_sudo=$C_ROOT ;;
    'sudo?') c_sudo=$C_DIM ;;
  esac
  traffic="${TOOL_TRAFFIC[$name]:-}"
  case "$traffic" in
    loud)  c_traffic=$C_WARN ;;
    probe) c_traffic=$C_AMBER ;;
  esac
  if [[ -n "$num" ]]; then
    printf '  %2s) ' "$num"
  else
    printf '  '
  fi
  printf '%s%-10s%s  %s%-5s%s  %s%-5s%s   %s\n' \
    "$C_BOLD" "$name" "$C_OFF" \
    "$c_sudo" "$sudo_txt" "$C_OFF" \
    "$c_traffic" "$traffic" "$C_OFF" \
    "$(describe "$name")"
}

# Flat, stable listing: one tool per line, no section headers, so it stays easy
# to grep and parse. The interactive menu is the grouped, human-facing view.
list_tools() {
  local t
  printf '%snetpack (npk)   v%s%s\n' "$C_AMBER" "$(netpack_version)" "$C_OFF"
  echo
  for t in "${TOOLS[@]}"; do
    tool_row "" "$t"
  done
  echo
  print_legend
}

# Terminal height, for deciding how much menu decoration fits. An inherited
# LINES wins, as elsewhere in POSIX tooling; otherwise ask the terminal (which
# also picks up window resizes between draws).
term_rows() {
  local rows="$NP_LINES"
  if [[ ! "$rows" =~ ^[0-9]+$ ]] && command -v tput >/dev/null 2>&1; then
    rows="$(tput lines 2>/dev/null || true)"
  fi
  [[ "$rows" =~ ^[0-9]+$ ]] || rows=24
  printf '%s\n' "$rows"
}

# Orientation line: which interface, address and gateway the defaults will use,
# plus privilege state. Never fatal — a missing piece is itself evidence, so it
# renders in red instead of aborting the menu.
print_context() {
  local iface='' addr='' gw=''
  iface="$(ip -o route get 1.1.1.1 2>/dev/null \
    | awk '{for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit }}')" || true
  if [[ -z "$iface" ]]; then
    iface="$(ip -o -4 addr show scope global 2>/dev/null | awk 'NR == 1 { print $2 }')" || true
  fi
  if [[ -n "$iface" ]]; then
    addr="$(ip -o -4 addr show dev "$iface" scope global 2>/dev/null \
      | awk 'NR == 1 { print $4 }')" || true
  fi
  gw="$(ip -o route show default 2>/dev/null \
    | awk '{for (i = 1; i < NF; i++) if ($i == "via") { print $(i + 1); exit }}')" || true

  # SSID on wireless: red "none" when iw confirms no association. Without
  # iw the association is unmeasured, so nothing is shown.
  local ssid=''
  if [[ -n "$iface" && -d "/sys/class/net/${iface}/wireless" ]] \
      && command -v iw >/dev/null 2>&1; then
    ssid="$(iw dev "$iface" link 2>/dev/null \
      | awk -F': ' '/^[[:space:]]*SSID:/ { print $2; exit }')" || true
    [[ -n "$ssid" ]] || ssid='-'
  fi

  printf '  %slink%s  ' "$C_DIM" "$C_OFF"
  if [[ -n "$iface" ]]; then
    printf '%s%s%s ' "$C_BOLD" "$iface" "$C_OFF"
    if [[ -n "$addr" ]]; then
      printf '%s' "$addr"
    else
      printf '%sno address%s' "$C_WARN" "$C_OFF"
    fi
    if [[ "$ssid" == '-' ]]; then
      printf '  %sssid%s %snone%s' "$C_DIM" "$C_OFF" "$C_WARN" "$C_OFF"
    elif [[ -n "$ssid" ]]; then
      printf '  %sssid%s %s' "$C_DIM" "$C_OFF" "$ssid"
    fi
  else
    printf '%sno interface%s' "$C_WARN" "$C_OFF"
  fi
  printf '  %sgw%s ' "$C_DIM" "$C_OFF"
  if [[ -n "$gw" ]]; then
    printf '%s' "$gw"
  else
    printf '%snone%s' "$C_WARN" "$C_OFF"
  fi
  if [[ "$(id -u)" -eq 0 ]]; then
    printf '  %sroot%s\n' "$C_ROOT" "$C_OFF"
  else
    printf '  %sroot: no%s\n' "$C_DIM" "$C_OFF"
  fi
  # Capture is a property of the whole session, so say so on every draw rather
  # than only at the run that writes a file.
  if [[ -n "$CAPTURE_DIR" ]]; then
    printf '  %srec %s%s\n' "$C_OK" "$CAPTURE_DIR" "$C_OFF"
  fi
}

print_banner() {
  printf '%s' "$C_AMBER"
  cat <<'EOF'

               _                    _
   _ __   ___| |_ _ __   __ _  ___| | __
  | '_ \ / _ \ __| '_ \ / _` |/ __| |/ /
  | | | |  __/ |_| |_) | (_| | (__|   <
  |_| |_|\___|\__| .__/ \__,_|\___|_|\_\
                 |_|
EOF
  echo
  printf "  netpack (npk)   v%s\n" "$(netpack_version)"
  printf '%s' "$C_OFF"
}

print_keys() {
  echo
  printf '  %sMenu keys%s\n' "$C_AMBER" "$C_OFF"
  printf '    %-20s %s\n' "N | <tool>" "run by number or by name (e.g. 11, path3)"
  printf '    %-20s %s\n' "Up/Down" "cycle through the menu entries"
  printf '    %-20s %s\n' "N <args>" "run with arguments, skipping prompts (e.g. 2 -t 30)"
  printf '    %-20s %s\n' "?N | ?<tool>" "show that tool's --help (e.g. ?11)"
  printf '    %-20s %s\n' "d" "doctor — dependency and readiness checks"
  printf '    %-20s %s\n' "p | p <name>" "guided playbooks for a symptom (e.g. p wan)"
  printf '    %-20s %s\n' "r" "repeat the previous run"
  printf '    %-20s %s\n' "q | Ctrl-D" "quit"
  echo
  printf '  %sPrompts appear only for values a tool cannot default. Supplying\n' "$C_DIM"
  printf '  arguments inline skips them entirely.%s\n' "$C_OFF"
}

MENU_TOOLS=()   # menu number (1-based) -> tool name
LAST_RUN=()     # most recent menu invocation: [sudo] tool args...

build_menu_index() {
  local section
  local -a section_tools=()
  MENU_TOOLS=()
  for section in "${SECTIONS[@]}"; do
    read -r -a section_tools <<<"${section#*:}"
    MENU_TOOLS+=("${section_tools[@]}")
  done
}

# menu_rule TITLE — amber rule to the banner width (42) around a plain title.
# Substitution, not substring: a C locale would slice the multibyte dash.
menu_rule() {
  local title=$1 fill=''
  printf -v fill '%*s' "$(( 42 - 4 - ${#title} ))" ''
  fill=${fill// /─}
  printf '  %s──%s %s %s%s%s\n' \
    "$C_AMBER" "$C_OFF" "$title" "$C_AMBER" "$fill" "$C_OFF"
}

# A non-tool menu row, aligned with the tag columns tool_row uses.
plain_row() {
  printf '  %2s) %s%-10s%s  %-5s  %-5s   %s\n' \
    "$1" "$C_BOLD" "$2" "$C_OFF" "" "" "$3"
}

# render_menu BANNER SECTIONS LEGEND — emit the menu body at one decoration
# level. draw_menu picks the richest level that fits the terminal.
render_menu() {
  local banner=$1 sections=$2 legend=$3
  local section title name i=1
  local -a section_tools=()
  if (( banner )); then
    print_banner
  else
    printf '\n  %snetpack (npk)   v%s%s\n' "$C_AMBER" "$(netpack_version)" "$C_OFF"
  fi
  echo
  print_context
  if (( sections )); then
    for section in "${SECTIONS[@]}"; do
      title=${section%%:*}
      read -r -a section_tools <<<"${section#*:}"
      echo
      menu_rule "$title"
      for name in "${section_tools[@]}"; do
        tool_row "$i" "$name"
        i=$((i + 1))
      done
    done
  else
    echo
    for name in "${MENU_TOOLS[@]}"; do
      tool_row "$i" "$name"
      i=$((i + 1))
    done
  fi
  echo
  # The letter rows get a rule of their own; it sheds with the section rules.
  if (( sections )); then
    menu_rule "Menu keys"
  fi
  tool_row d doctor
  plain_row p playbook "Guided sequences for a symptom"
  if (( ${#LAST_RUN[@]} )); then
    plain_row r repeat "${LAST_RUN[*]}"
  fi
  plain_row q quit Exit
  echo
  if (( legend )); then
    print_legend
    # Emitted inside render_menu so the fit test sheds it with the legend.
    echo
    printf '  %s↑↓ select · number or name · ? for keys · q to quit%s\n' \
      "$C_AMBER" "$C_OFF"
  else
    printf '  %ssudo%s root   %ssudo?%s asks   %sprobe%s light traffic   %sloud%s planned tests only\n' \
      "$C_ROOT" "$C_OFF" "$C_DIM" "$C_OFF" "$C_AMBER" "$C_OFF" "$C_WARN" "$C_OFF"
  fi
  echo
}

# Decoration levels, richest first: "banner sections legend". Rendering is
# cheap, so the fit test measures real output instead of guessing row counts.
MENU_LEVELS=("1 1 1" "0 1 1" "0 1 0" "0 0 0")

# draw_menu ALLOW_BANNER — sheds decoration on short terminals so the tool rows
# and the prompt stay on screen (the uConsole console is not tall).
draw_menu() {
  local allow_banner=$1
  local rows level
  local -a lines=() opts=()
  rows="$(term_rows)"
  for level in "${MENU_LEVELS[@]}"; do
    read -r -a opts <<<"$level"
    (( allow_banner )) || opts[0]=0
    mapfile -t lines < <(render_menu "${opts[0]}" "${opts[1]}" "${opts[2]}")
    # +1 leaves room for the prompt line that follows.
    if (( ${#lines[@]} + 1 <= rows )); then
      break
    fi
  done
  printf '%s\n' "${lines[@]}"
}

# --- interactive helpers -----------------------------------------------------

# ask_value LABEL [DEFAULT] -> REPLY_VALUE. Empty input takes DEFAULT, or
# re-prompts when there is none. Returns 1 on 'q'/EOF so the caller can cancel
# back to the menu instead of exiting.
REPLY_VALUE=''
ask_value() {
  local label=$1 default=${2:-} val
  while :; do
    if [[ -n "$default" ]]; then
      printf '  %s [%s]: ' "$label" "$default"
    else
      printf '  %s: ' "$label"
    fi
    if ! read -r val; then
      echo
      return 1
    fi
    case "$val" in
      q|Q) return 1 ;;
    esac
    if [[ -z "$val" ]]; then
      if [[ -n "$default" ]]; then
        REPLY_VALUE=$default
        return 0
      fi
      printf '  %srequired — enter a value, or q to cancel%s\n' "$C_AMBER" "$C_OFF"
      continue
    fi
    REPLY_VALUE=$val
    return 0
  done
}

# ask_choice LABEL DEFAULT CHOICE... -> REPLY_VALUE. Returns 1 on cancel.
ask_choice() {
  local label=$1 default=$2
  shift 2
  local -a choices=("$@")
  local c val
  while :; do
    printf '  %s (%s) [%s]: ' "$label" "$(IFS='/'; echo "${choices[*]}")" "$default"
    if ! read -r val; then
      echo
      return 1
    fi
    case "$val" in
      q|Q) return 1 ;;
      '') REPLY_VALUE=$default; return 0 ;;
    esac
    for c in "${choices[@]}"; do
      if [[ "$val" == "$c" ]]; then
        REPLY_VALUE=$val
        return 0
      fi
    done
    printf '  %sexpected one of: %s%s\n' "$C_AMBER" "${choices[*]}" "$C_OFF"
  done
}

# Prompt for the values a tool cannot default, plus explicit mode choices.
# Fills PROMPT_ARGS; returns 1 when the user cancels.
PROMPT_ARGS=()
prompt_args() {
  local name=$1
  local -a ports=()
  PROMPT_ARGS=()
  case "$name" in
    cabletest)
      # The tool refuses without -y, so the menu has to ask for it rather than
      # launching a run that can only fail. Default is no: this drops the link.
      ask_choice "Drops the link on this interface while it measures — continue?" \
        n y n || return 1
      [[ "$REPLY_VALUE" == "y" ]] || return 1
      PROMPT_ARGS+=(-y)
      ;;
    portcheck)
      ask_value "HOST or IP (e.g. 192.168.1.50)" || return 1
      PROMPT_ARGS+=("$REPLY_VALUE")
      ask_value "PORT(S), space-separated (e.g. 22 443 5201)" || return 1
      read -r -a ports <<<"$REPLY_VALUE"
      PROMPT_ARGS+=("${ports[@]+"${ports[@]}"}")
      ;;
    path3)
      ask_value "TARGET host or IP" "1.1.1.1" || return 1
      PROMPT_ARGS+=("$REPLY_VALUE")
      ;;
    ringcap)
      ask_value "Output directory (created if missing)" "/tmp/ringcap" || return 1
      PROMPT_ARGS+=(-d "$REPLY_VALUE")
      ;;
    testcli)
      ask_value "HOST running testsrv (e.g. 192.168.1.50)" || return 1
      PROMPT_ARGS+=("$REPLY_VALUE")
      ;;
    mcastcheck)
      ask_choice "Mode — recv listens, send transmits probes" recv recv send || return 1
      PROMPT_ARGS+=("$REPLY_VALUE")
      ;;
  esac
}

# --- evidence capture --------------------------------------------------------

# When set (npk -o DIR), every run started through the launcher is written to
# DIR alongside a manifest row. This is how the tools that have no --dump of
# their own still leave evidence behind: the terminal report is the evidence,
# so it is retained with the command that produced it and the code it exited.
CAPTURE_DIR=""

# Manifest columns, tab-separated after a commented header, so a site visit can
# be read as a timeline by eye or cut into a spreadsheet.
capture_init() {
  local manifest="${CAPTURE_DIR}/manifest.tsv"
  mkdir -p "$CAPTURE_DIR" || {
    echo "error: cannot create capture directory: ${CAPTURE_DIR}" >&2
    exit 1
  }
  # Evidence can name hosts and topology; keep it owner-only.
  chmod 700 "$CAPTURE_DIR" 2>/dev/null || true
  if [[ ! -f "$manifest" ]]; then
    printf '# netpack capture manifest\n# started\tended\texit\tlog\tcommand\n' >"$manifest"
  fi
}

# capture_run NAME CMD... — run CMD with its output teed into the capture
# directory, then append one manifest row. Returns the tool's exit code.
#
# stderr is merged into the log deliberately: the point is an archive of the
# whole run, so warnings and die() messages belong with the report rather than
# scrolling past uncaptured. Tools drop colour on their own here because the
# tee pipeline means stdout is not a TTY, so the log stays plain text.
#
# tee runs with -i: Ctrl-C is the normal stop for ringcap, splitloss and
# mcastcheck recv, and the summary those tools print after the interrupt is
# the evidence. A default-disposition tee dies with the SIGINT and takes that
# summary (and the tool's real exit code) with it.
capture_run() {
  local name=$1
  shift
  local stamp log manifest rc=0 started ended arg
  local -a shown=()
  stamp="$(date +%Y%m%d-%H%M%S)"
  log="${CAPTURE_DIR}/${name}-${stamp}.log"
  manifest="${CAPTURE_DIR}/manifest.tsv"
  # Record the command as it would be retyped ("sudo segscan -i eth0"), not the
  # resolved bin path — the manifest is meant to be reproducible by a reader.
  for arg in "$@"; do
    if [[ "$arg" == "${BIN_DIR}/"* ]]; then
      shown+=("${arg##*/}")
    else
      shown+=("$arg")
    fi
  done
  started="$(date +%Y-%m-%dT%H:%M:%S%z | sed -E 's/([0-9]{2})([0-9]{2})$/\1:\2/')"
  set +e
  "$@" 2>&1 | tee -i "$log"
  rc=${PIPESTATUS[0]}
  set -e
  ended="$(date +%Y-%m-%dT%H:%M:%S%z | sed -E 's/([0-9]{2})([0-9]{2})$/\1:\2/')"
  printf '%s\t%s\t%s\t%s\t%s\n' \
    "$started" "$ended" "$rc" "${log##*/}" "${shown[*]}" >>"$manifest"
  printf '  %scaptured: %s%s\n' "$C_DIM" "$log" "$C_OFF"
  return "$rc"
}

tool_path() {
  local name=$1
  local path="${BIN_DIR}/${name}"
  if [[ ! -x "$path" ]]; then
    echo "error: tool not found or not executable: ${name}" >&2
    echo "hint: run 'netpack list'" >&2
    return 1
  fi
  printf '%s\n' "$path"
}

# Resolve a menu selection (number or tool name) to a tool name; empty on miss.
resolve_selection() {
  local sel=$1 t
  case "$sel" in
    d|D) printf 'doctor\n'; return 0 ;;
  esac
  if [[ "$sel" =~ ^[0-9]+$ ]]; then
    # 10# guards against leading zeros being read as octal
    sel=$((10#$sel))
    if (( sel >= 1 && sel <= ${#MENU_TOOLS[@]} )); then
      printf '%s\n' "${MENU_TOOLS[$((sel - 1))]}"
    fi
    return 0
  fi
  for t in "${TOOLS[@]}"; do
    if [[ "$sel" == "$t" ]]; then
      printf '%s\n' "$t"
      return 0
    fi
  done
}

exit_note() {
  case "$1" in
    0)   printf 'clean / expected' ;;
    1)   printf 'usage, dependency, or permission error' ;;
    130) printf 'interrupted' ;;
    *)   printf 'condition found' ;;
  esac
}

# Show a tool's own --help without leaving the menu.
show_tool_help() {
  local name=$1 path
  path="$(tool_path "$name")" || return 0
  echo
  if [[ -t 0 && -t 1 ]] && command -v less >/dev/null 2>&1; then
    "$path" --help 2>&1 | less -FRX || true
  else
    "$path" --help 2>&1 || true
  fi
}

# Run a tool from the menu: decide sudo, collect missing arguments, echo the
# equivalent command line, then return to the menu with the exit code explained.
# Set when the operator backed out of a run at one of its prompts, so the
# playbook runner can stop the sequence instead of marching to the next step.
MENU_CANCELLED=0

menu_run() {
  local name=$1
  shift
  local -a args=("$@")
  local -a prefix=()
  local path rc=0 ans
  MENU_CANCELLED=0
  path="$(tool_path "$name")" || return 0
  echo

  if wants_root "$name" && [[ "$(id -u)" -ne 0 ]] \
      && command -v sudo >/dev/null 2>&1; then
    if needs_root "$name"; then
      prefix=(sudo)
    else
      printf '  %s uses root for full results; run with sudo? [Y/n]: ' "$name"
      if ! read -r ans; then
        echo
        MENU_CANCELLED=1
        return 0
      fi
      case "$ans" in
        n|N|no|NO) ;;
        q|Q) MENU_CANCELLED=1; return 0 ;;
        *) prefix=(sudo) ;;
      esac
    fi
  fi

  if (( ${#args[@]} == 0 )); then
    if ! prompt_args "$name"; then
      MENU_CANCELLED=1
      return 0
    fi
    args=("${PROMPT_ARGS[@]+"${PROMPT_ARGS[@]}"}")
  fi

  LAST_RUN=("${prefix[@]+"${prefix[@]}"}" "$name" "${args[@]+"${args[@]}"}")
  # Echo the equivalent command line: reproducible outside the menu, and it
  # belongs in an evidence timeline.
  printf '  %s$ %s%s\n' "$C_DIM" "${LAST_RUN[*]}" "$C_OFF"
  # Consequences at the point of action: loud tools state what they will do
  # to the network before they start doing it.
  local impact
  impact="$(impact_note "$name")"
  if [[ -n "$impact" ]]; then
    printf '  %sloud%s  %s\n' "$C_WARN" "$C_OFF" "$impact"
  fi
  echo

  # Ctrl-C is how ringcap, splitloss and mcastcheck recv are meant to be
  # stopped; ignore it here so stopping the tool returns to the menu.
  trap ':' INT
  if [[ -n "$CAPTURE_DIR" ]]; then
    capture_run "$name" \
      "${prefix[@]+"${prefix[@]}"}" "$path" "${args[@]+"${args[@]}"}" || rc=$?
  else
    "${prefix[@]+"${prefix[@]}"}" "$path" "${args[@]+"${args[@]}"}" || rc=$?
  fi
  trap - INT

  echo
  if (( rc == 0 )); then
    printf '  %s%s exit 0 — %s%s\n' "$C_OK" "$name" "$(exit_note "$rc")" "$C_OFF"
  elif (( rc == 1 )); then
    printf '  %s%s exit 1 — %s%s\n' "$C_WARN" "$name" "$(exit_note "$rc")" "$C_OFF"
  else
    printf '  %s%s exit %d — %s (meaning: %s --help)%s\n' \
      "$C_AMBER" "$name" "$rc" "$(exit_note "$rc")" "$name" "$C_OFF"
  fi
  pause
}

# What the next Enter does. The playbook runner overrides this so the prompt
# after a step offers the next step rather than the menu.
PAUSE_HINT="Enter for the menu, q to quit"

# --- playbooks ---------------------------------------------------------------

# Numbered list of playbooks, with each one's step count.
list_playbooks() {
  local id i=1 steps
  printf '\n  %sGuided playbooks%s\n' "$C_AMBER" "$C_OFF"
  printf '  %srun these while the symptom is present%s\n\n' "$C_DIM" "$C_OFF"
  for id in "${PLAYBOOK_IDS[@]}"; do
    steps="$(playbook_steps "$id" | wc -l)"
    printf '  %2s) %s%-10s%s  %s%s (%s steps)%s\n' \
      "$i" "$C_BOLD" "$id" "$C_OFF" "" "$(playbook_title "$id")" "$steps" "$C_OFF"
    i=$((i + 1))
  done
  printf '\n  %sThroughput and bufferbloat need a second machine running testsrv;\n' "$C_DIM"
  printf '  those procedures stay in the README.%s\n' "$C_OFF"
}

# Resolve a number or id to a playbook id; empty on miss.
resolve_playbook() {
  local sel=$1 id
  if [[ "$sel" =~ ^[0-9]+$ ]]; then
    sel=$((10#$sel))
    if (( sel >= 1 && sel <= ${#PLAYBOOK_IDS[@]} )); then
      printf '%s\n' "${PLAYBOOK_IDS[$((sel - 1))]}"
    fi
    return 0
  fi
  for id in "${PLAYBOOK_IDS[@]}"; do
    if [[ "$sel" == "$id" ]]; then
      printf '%s\n' "$id"
      return 0
    fi
  done
}

# Walk a playbook: state why each step is being run, run it through menu_run
# (which keeps privilege, prompting, impact notices and capture identical to a
# hand-picked run), and stop for the operator to read the result between steps.
run_playbook() {
  local id=$1
  local -a steps=() fields=()
  local line cmd why total i=1 saved_hint=$PAUSE_HINT
  mapfile -t steps < <(playbook_steps "$id")
  total=${#steps[@]}
  if (( total == 0 )); then
    printf '\n  %sno such playbook: %s%s\n' "$C_WARN" "$id" "$C_OFF"
    return 0
  fi

  echo
  printf '  %s%s%s\n' "$C_AMBER" "$(playbook_title "$id")" "$C_OFF"
  printf '  %s%d steps — q at any prompt leaves the playbook%s\n' \
    "$C_DIM" "$total" "$C_OFF"

  for line in "${steps[@]}"; do
    cmd=${line%%$'\t'*}
    why=${line#*$'\t'}
    echo
    printf '  %s── step %d of %d ──%s\n' "$C_AMBER" "$i" "$total" "$C_OFF"
    printf '  %s%s%s\n' "$C_BOLD" "$cmd" "$C_OFF"
    printf '  %s%s%s\n' "$C_DIM" "$why" "$C_OFF"
    if (( i < total )); then
      PAUSE_HINT="Enter for step $((i + 1)) of ${total}, q to quit"
    else
      PAUSE_HINT="Enter to finish the playbook, q to quit"
    fi
    read -r -a fields <<<"$cmd"
    menu_run "${fields[0]}" "${fields[@]:1}"
    if (( MENU_CANCELLED )); then
      PAUSE_HINT=$saved_hint
      printf '\n  %splaybook stopped at step %d of %d%s\n' \
        "$C_AMBER" "$i" "$total" "$C_OFF"
      return 0
    fi
    i=$((i + 1))
  done

  PAUSE_HINT=$saved_hint
  echo
  printf '  %splaybook complete: %s%s\n' "$C_OK" "$(playbook_title "$id")" "$C_OFF"
  if [[ -n "$CAPTURE_DIR" ]]; then
    printf '  %sevidence in %s%s\n' "$C_DIM" "$CAPTURE_DIR" "$C_OFF"
  fi
}

pause() {
  local ans
  echo
  printf '  %s%s: %s' "$C_AMBER" "$PAUSE_HINT" "$C_OFF"
  if ! read -r ans; then
    echo
    quit
  fi
  case "$ans" in
    q|Q|quit|QUIT) quit ;;
  esac
}

quit() {
  echo
  printf '%sSee you, space cowboy...%s\n' "$C_AMBER" "$C_OFF"
  exit 0
}

# Read one line at the menu prompt into MENU_LINE; returns 1 on EOF. On a
# TTY, Up and Down cycle through the menu entries (tools, then doctor,
# playbook, quit) and rewrite the line with a word the dispatcher already
# accepts; typed input behaves as before, including trailing arguments.
read_menu_line() {
  MENU_LINE=''
  if [[ ! -t 0 ]]; then
    IFS= read -r MENU_LINE || return 1
    return 0
  fi
  local -a cycle=("${MENU_TOOLS[@]}" doctor playbook quit)
  local n=${#cycle[@]} line='' key seq idx=-1
  redraw() {
    printf '\r  %snpk>%s %s\033[K' "$C_AMBER" "$C_OFF" "$line"
  }
  while :; do
    IFS= read -rsn1 key || key=$'\004'
    case "$key" in
      $'\033')
        # Arrows arrive as ESC [ A/B (or ESC O A/B in application mode);
        # anything else after Escape is swallowed rather than echoed.
        seq=''
        IFS= read -rsn2 -t 0.05 seq || true
        case "$seq" in
          '[B'|'OB') idx=$(( (idx + 1) % n )) ;;
          '[A'|'OA')
            if (( idx < 0 )); then
              idx=$(( n - 1 ))
            else
              idx=$(( (idx - 1 + n) % n ))
            fi
            ;;
          *) continue ;;
        esac
        line=${cycle[idx]}
        redraw
        ;;
      ''|$'\n')
        break
        ;;
      $'\004')
        # Ctrl-D / EOF: quit on an empty line, otherwise submit what's there.
        [[ -n "$line" ]] || return 1
        break
        ;;
      $'\177'|$'\b')
        line=${line%?}
        idx=-1
        redraw
        ;;
      $'\025')
        # Ctrl-U clears the line, matching the shell reflex.
        line=''
        idx=-1
        redraw
        ;;
      *)
        line+=$key
        idx=-1
        printf '%s' "$key"
        ;;
    esac
  done
  printf '\n'
  MENU_LINE=$line
}

menu() {
  local sel name banner=1
  local -a fields=()
  build_menu_index
  splash_maybe
  while :; do
    draw_menu "$banner"
    banner=0
    printf '  %snpk>%s ' "$C_AMBER" "$C_OFF"
    if ! read_menu_line; then
      echo
      quit
    fi
    sel=$MENU_LINE
    case "$sel" in
      q|Q|quit|QUIT|exit|EXIT|cancel|CANCEL) quit ;;
    esac
    # Split the line so a selection can carry arguments: "2 -t 30".
    read -r -a fields <<<"$sel"
    if (( ${#fields[@]} == 0 )); then
      continue
    fi
    sel=${fields[0]}
    fields=("${fields[@]:1}")
    # Accept both "?11" and "? 11".
    if [[ "$sel" == '?' && ${#fields[@]} -gt 0 ]]; then
      sel="?${fields[0]}"
      fields=("${fields[@]:1}")
    fi
    case "$sel" in
      '?'|h|H|help)
        print_keys
        pause
        continue
        ;;
      '?'*)
        name="$(resolve_selection "${sel#\?}")"
        if [[ -z "$name" ]]; then
          printf '\n  %sno such tool: %s%s\n' "$C_WARN" "${sel#\?}" "$C_OFF"
        else
          show_tool_help "$name"
        fi
        pause
        continue
        ;;
      p|P|playbook)
        if (( ${#fields[@]} )); then
          name="$(resolve_playbook "${fields[0]}")"
        else
          list_playbooks
          printf '\n%s  Playbook (number or name, Enter to go back): %s' "$C_AMBER" "$C_OFF"
          if ! read -r sel; then
            echo
            quit
          fi
          [[ -n "$sel" ]] || continue
          name="$(resolve_playbook "$sel")"
        fi
        if [[ -z "$name" ]]; then
          printf '\n  %sno such playbook: %s%s\n' "$C_WARN" "${fields[0]:-$sel}" "$C_OFF"
          pause
        else
          run_playbook "$name"
          pause
        fi
        continue
        ;;
      r|R)
        if (( ${#LAST_RUN[@]} == 0 )); then
          printf '\n  %snothing to repeat yet%s\n' "$C_AMBER" "$C_OFF"
          pause
          continue
        fi
        # LAST_RUN may start with sudo; menu_run re-derives privilege itself.
        fields=("${LAST_RUN[@]}")
        if [[ "${fields[0]}" == sudo ]]; then
          fields=("${fields[@]:1}")
        fi
        name=${fields[0]}
        fields=("${fields[@]:1}")
        menu_run "$name" "${fields[@]+"${fields[@]}"}"
        continue
        ;;
    esac
    name="$(resolve_selection "$sel")"
    if [[ -z "$name" ]]; then
      printf '\n  %sunknown selection: %s%s\n' "$C_WARN" "$sel" "$C_OFF"
      printf '  %stry a number 1-%d, a tool name, or ? for the keys%s\n' \
        "$C_DIM" "${#MENU_TOOLS[@]}" "$C_OFF"
      pause
      continue
    fi
    menu_run "$name" "${fields[@]+"${fields[@]}"}"
  done
}

# Direct invocation: exec so the tool's exit code is netpack's exit code.
# Under capture the run must be survived rather than exec'd, so the manifest
# row can record how it ended; the exit code is still passed through.
run_tool() {
  local name=$1
  shift
  local path rc=0
  path="$(tool_path "$name")" || exit 1
  if [[ -n "$CAPTURE_DIR" ]]; then
    # Survive the Ctrl-C that stops the tool, so the manifest row still
    # records how the run ended.
    trap ':' INT
    capture_run "$name" "$path" "$@" || rc=$?
    trap - INT
    exit "$rc"
  fi
  exec "$path" "$@"
}

main() {
  # Global options, which precede the tool name.
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -o|--out)
        if [[ $# -lt 2 || -z "$2" ]]; then
          echo "error: ${1} requires a directory" >&2
          exit 1
        fi
        CAPTURE_DIR=$2
        capture_init
        shift 2
        ;;
      *) break ;;
    esac
  done

  if [[ $# -eq 0 ]]; then
    menu
  fi
  case "$1" in
    help|-h|--help)
      usage
      ;;
    -V|--version)
      printf '%snetpack (npk)   v%s%s\n' "$C_AMBER" "$(netpack_version)" "$C_OFF"
      ;;
    list|ls)
      list_tools
      ;;
    playbooks)
      list_playbooks
      ;;
    splash)
      # Preview the menu splash on demand; deliberate, so it ignores the
      # NETPACK_NO_SPLASH opt-out (splash_play still requires a TTY) and
      # always includes the satellite flyby that is random in the menu.
      splash_play satellite
      ;;
    playbook)
      shift
      if [[ $# -eq 0 ]]; then
        list_playbooks
        exit 0
      fi
      local pb
      pb="$(resolve_playbook "$1")"
      if [[ -z "$pb" ]]; then
        echo "error: unknown playbook: ${1}" >&2
        echo "hint: run 'netpack playbooks'" >&2
        exit 1
      fi
      shift
      if [[ $# -gt 0 ]]; then
        echo "error: unexpected argument: ${1}" >&2
        exit 1
      fi
      build_menu_index
      run_playbook "$pb"
      ;;
    *)
      local name=$1
      shift
      local t
      for t in "${TOOLS[@]}"; do
        if [[ "$name" == "$t" ]]; then
          run_tool "$t" "$@"
        fi
      done
      echo "error: unknown tool: ${name}" >&2
      echo "hint: run 'netpack list'" >&2
      exit 1
      ;;
  esac
}

# Tests source this file to inspect the tool metadata; skip the menu for them.
if [[ "${NETPACK_SOURCE_ONLY:-0}" != 1 ]]; then
  main "$@"
fi
