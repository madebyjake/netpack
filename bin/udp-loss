#!/usr/bin/env bash
# udp-loss — measure UDP path loss using DNS queries that receive UDP replies
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/netpack.sh
source "${ROOT}/lib/netpack.sh"
# shellcheck source=../lib/netpack/parsers.sh
source "${ROOT}/lib/netpack/parsers.sh"

COUNT=100
NAME="cloudflare.com"
SERVERS=()
IFACE=""

usage() {
  cat <<'EOF'
udp-loss — measure UDP transit using DNS queries that elicit UDP replies.

Counts a query as successful when a UDP reply is received (including error
responses such as SERVFAIL/REFUSED). This distinguishes datagram delivery from
ICMP port-unreachable rate limiting seen in mtr -u final-hop loss.

On a multi-homed machine, -i binds the queries to IFACE's address so a chosen
uplink is measured instead of the default route's. Every server is off-link, so
the run needs a policy route (ip rule) steering that address out IFACE; without
one it exits 1 rather than measuring rp_filter drops as UDP loss.

Usage:
  udp-loss [-i IFACE] [-c COUNT] [-n NAME] [-s SERVER]... [--dump FILE]

Options:
  -i IFACE       Bind queries to IFACE's address (multi-homed)
  -c COUNT       Queries per server (default: 100)
  -n NAME        Query name (default: cloudflare.com)
  -s SERVER      DNS server (repeatable; default: 1.1.1.1 and 9.9.9.9)
  --dump FILE    Write JSON evidence to FILE
  -h, --help     Show this help

Queries are sequential; a heavily lossy path can take up to COUNT seconds
per server (1s timeout each).

Interpretation:
  Both clean            UDP replies received; treat isolated mtr -u final-hop
                        loss as likely ICMP rate limiting unless corroborated
  Both lossy            UDP loss or blocking in path
  One lossy, one clean  Destination-specific handling, not a shared path issue

Exit codes:
  0  all servers <=1% loss
  1  usage or dependency error; or -i could not bind an honest probe
  2  all servers >1% loss
  3  divergent results across servers
  130  interrupted; figures cover the queries actually sent

Ctrl-C stops the run and still reports. Loss is measured against the queries
sent, not the count requested, and a server the run never reached is listed as
not queried rather than as clean.
EOF
}

if [[ "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

take_dump_opt "$@"
set -- "${NP_ARGS[@]+"${NP_ARGS[@]}"}"

while getopts ":i:c:n:s:h" opt; do
  case "$opt" in
    i) IFACE=$OPTARG ;;
    c) COUNT=$OPTARG ;;
    n) NAME=$OPTARG ;;
    s) SERVERS+=("$OPTARG") ;;
    h) usage; exit 0 ;;
    *) usage >&2; exit 1 ;;
  esac
done
shift $((OPTIND - 1))
no_extra_args "$@"

require_uint count "$COUNT" 1
# Normalize to base 10: a validated "0100" is 100, but the query loop below
# would read the leading zero as octal and send 64 queries.
COUNT=$((10#$COUNT))
require_cmd dig awk sort

if [[ ${#SERVERS[@]} -eq 0 ]]; then
  SERVERS=(1.1.1.1 9.9.9.9)
fi

# The first server stands in for the uplink: every server here is off-link, so
# a binding that cannot reach one honestly cannot reach any of them.
DIG_BIND=()
if [[ -n "$IFACE" ]]; then
  SRC="$(require_uplink "$IFACE" "${SERVERS[0]}")"
  DIG_BIND=(-b "$SRC")
  VIA=$IFACE
else
  VIA="$(via_for "${SERVERS[0]}")"
fi

dump_begin
header udp-loss
echo "count: ${COUNT}  servers: ${SERVERS[*]}  name: ${NAME}${VIA:+  via: ${VIA}}"
if [[ -n "$IFACE" ]]; then
  multihomed_note "${IFACE} (bound with -i)"
else
  multihomed_note "$VIA" "pass -i IFACE to measure another uplink"
fi
echo

declare -a LOSS_PCTS=()

declare -a UNQUERIED=()

catch_int
for srv in "${SERVERS[@]}"; do
  # A server the run never reached is unmeasured, not clean: recording it as 0%
  # loss would put a server that was never asked anything into the evidence as
  # healthy.
  if interrupted; then
    UNQUERIED+=("$srv")
    continue
  fi
  ok=0
  fail=0
  rtts=()
  i=0
  while (( i < COUNT )) && ! interrupted; do
    # dig exits non-zero on a lost/timed-out query — the very event being
    # measured — so guard the pipeline or set -e/pipefail aborts at first loss.
    t="$(dig "${DIG_BIND[@]+"${DIG_BIND[@]}"}" @"$srv" "$NAME" A +time=1 +tries=1 +stats 2>/dev/null \
      | awk '/Query time:/ {print $4; exit}' || true)"
    if [[ -n "${t:-}" ]]; then
      ok=$((ok + 1))
      rtts+=("$t")
    else
      fail=$((fail + 1))
    fi
    i=$((i + 1))
    if (( i % 25 == 0 || i == COUNT )); then
      pulse "${srv}: ${i}/${COUNT}"
    fi
  done
  pulse_done "${srv}: ${i}/${COUNT} done"

  # Denominator is what was sent, not what was planned: one loss in eighty sent
  # is 1.2%, but divided by a requested COUNT of 200 it reads as 0.5% and
  # understates the fault.
  sent=$i
  loss="$(awk -v f="$fail" -v c="$sent" 'BEGIN { printf "%.1f", (c ? f * 100 / c : 0) }')"
  LOSS_PCTS+=("$loss")

  # Parsed into fields rather than a display string, so the report and the dump
  # carry the same numbers instead of the dump re-deriving them.
  rmin="" ravg="" rp95="" rmax=""
  if (( ok > 0 )); then
    IFS=$'\t' read -r rmin ravg rp95 rmax <<<"$(printf '%s\n' "${rtts[@]}" | sort -n | awk '
      { a[NR] = $1; s += $1 }
      END {
        p = int(NR * 0.95); if (p < 1) p = 1
        printf "%s\t%.1f\t%s\t%s", a[1], s / NR, a[p], a[NR]
      }')"
    stats="min ${rmin}ms avg ${ravg}ms p95 ${rp95}ms max ${rmax}ms"
  else
    stats="no replies"
  fi

  printf '%-16s sent %-4d ok %-4d lost %-3d (%s)  %s%s\n' \
    "$srv" "$sent" "$ok" "$fail" "$(color_loss_pct "$loss")" "$stats" \
    "$( (( sent < COUNT )) && printf ' — cut short at %d of %d' "$sent" "$COUNT")"

  # queried=true and an rtt of null when nothing replied: no reply is a real
  # measurement, an absent rtt is simply not a number.
  dump_row servers "s:server=${srv}" "b:queried=true" \
    "n:sent=${sent}" "n:received=${ok}" "n:lost=${fail}" "n:loss_pct=${loss}" \
    "n:rtt_min_ms=${rmin}" "n:rtt_avg_ms=${ravg}" \
    "n:rtt_p95_ms=${rp95}" "n:rtt_max_ms=${rmax}" \
    "b:complete=$( (( sent >= COUNT )) && echo true || echo false)"
done
release_int

for srv in "${UNQUERIED[@]+"${UNQUERIED[@]}"}"; do
  printf '%-16s %s\n' "$srv" "$(color_status warn "not queried — run interrupted first")"
  # Present in the evidence but with every figure null: the server was in the
  # run's scope, and omitting it entirely would hide that it went untested.
  dump_row servers "s:server=${srv}" "b:queried=false" \
    "n:sent=" "n:received=" "n:lost=" "n:loss_pct=" \
    "n:rtt_min_ms=" "n:rtt_avg_ms=" "n:rtt_p95_ms=" "n:rtt_max_ms=" \
    "b:complete=false"
done

emit_dump() {
  local code=$1
  [[ -n "$DUMP_PATH" ]] || return 0
  dump_num count_requested "$COUNT"
  dump_str query_name "$NAME"
  dump_opt_str iface "$IFACE"
  dump_opt_str via "$VIA"
  dump_num servers_queried "${#LOSS_PCTS[@]}"
  dump_num servers_total "${#SERVERS[@]}"
  dump_bool interrupted "$(interrupted && echo true || echo false)"
  dump_write "$DUMP_PATH" udp-loss "$code" || true
}

if interrupted; then
  note "interrupted — figures cover the queries sent before the run was stopped"
fi

# Nothing was measured at all: Ctrl-C landed before the first reply. There is no
# loss figure to classify, and reporting one would be inventing it.
if [[ ${#LOSS_PCTS[@]} -eq 0 ]]; then
  verdict "interrupted before any resolver was queried; no UDP evidence collected." \
    "Re-run and allow at least one server to complete."
  emit_dump 130
  finished
  exit 130
fi

case "$(classify_loss_set 1 "${LOSS_PCTS[@]}")" in
  all)
    verdict "UDP loss observed to all tested resolvers." \
      "Investigate path policing, NAT state, or venue/ISP UDP handling."
    emit_dump "$(interrupted && echo 130 || echo 2)"
    finished
    interrupted && exit 130
    exit 2
    ;;
  mixed)
    verdict "results diverge across resolvers." \
      "Likely destination-specific handling rather than a shared path fault."
    emit_dump "$(interrupted && echo 130 || echo 3)"
    finished
    interrupted && exit 130
    exit 3
    ;;
  *)
    if interrupted; then
      verdict "UDP replies received from every resolver reached before the run was interrupted." \
        "A short sample hides intermittent loss; re-run to completion before reading this as clean."
      emit_dump 130
      finished
      exit 130
    fi
    verdict "UDP replies received from all tested resolvers." \
      "Final-hop loss in mtr -u is often ICMP rate limiting; corroborate before acting."
    emit_dump 0
    finished
    exit 0
    ;;
esac
