#!/usr/bin/env bash
# portcheck — TCP service reachability by port
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/netpack.sh
source "${ROOT}/lib/netpack.sh"
# shellcheck source=../lib/netpack/parsers.sh
source "${ROOT}/lib/netpack/parsers.sh"

TIMEOUT=3

usage() {
  cat <<'EOF'
portcheck — test TCP connectivity to specific service ports.

Answers "can I reach this service from here": game servers, stream ingest,
VPN endpoints, printers. Uses bash /dev/tcp connect() only — no payload is
sent and nothing is installed.

Result meanings:
  OPEN         connect() succeeded; something is listening
  REFUSED      host answered with RST — host is up, port closed
  TIMEOUT      no answer — filtered by a firewall, or host down
  DNS FAIL     name did not resolve (see dnscheck)
  UNREACHABLE  no route to the host from here

No UDP mode: without an application reply a bare UDP probe proves nothing.
Use udp-loss for UDP delivery evidence.

No -i: the probe is a bash /dev/tcp connect(), which cannot bind a source
address, and pulling in nc or socat to gain one would add a dependency and
change what the probe proves. On a multi-homed machine the report names the
interface the connect went out on; to test another uplink, run from a host on
it, or use a policy route.

Usage:
  portcheck [-t SECONDS] [--dump FILE] HOST PORT [PORT...]

Options:
  -t SECONDS    Per-port connect timeout (default: 3)
  --dump FILE   Write JSON evidence to FILE
  -h, --help    Show this help

Exit codes:
  0  all ports connected
  1  usage or dependency error
  2  one or more ports did not connect
  130  interrupted; only the ports already probed were tested

Ctrl-C stops the run and still reports. Ports not reached are listed as not
probed rather than counted as closed.
EOF
}

if [[ "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

take_dump_opt "$@"
set -- "${NP_ARGS[@]+"${NP_ARGS[@]}"}"

while getopts ":t:h" opt; do
  case "$opt" in
    t) TIMEOUT=$OPTARG ;;
    h) usage; exit 0 ;;
    *) usage >&2; exit 1 ;;
  esac
done
shift $((OPTIND - 1))

HOST=${1:-}
[[ -n "$HOST" ]] || { usage >&2; exit 1; }
shift
[[ $# -ge 1 ]] || { usage >&2; exit 1; }

# Accept both space- and comma-separated port lists.
PORTS=()
for arg in "$@"; do
  for p in ${arg//,/ }; do
    PORTS+=("$p")
  done
done

require_uint timeout "$TIMEOUT" 1
for p in "${PORTS[@]}"; do
  require_uint port "$p" 1 65535
done
require_cmd timeout

FAILED=0

probe_port() {
  local host=$1 port=$2
  local err rc=0 t0 t1 ms=""
  t0="${EPOCHREALTIME:-}"
  # LC_ALL=C: the case below classifies bash's English error strings, which a
  # localized bash would otherwise translate into the generic FAIL bucket.
  # $0/$1 belong to the inner bash -c, not this shell
  # shellcheck disable=SC2016
  err="$(LC_ALL=C timeout "$TIMEOUT" bash -c 'exec 3<>"/dev/tcp/$0/$1"' "$host" "$port" 2>&1)" || rc=$?
  t1="${EPOCHREALTIME:-}"
  if [[ -n "$t0" && -n "$t1" ]]; then
    ms="$(awk -v a="$t0" -v b="$t1" 'BEGIN { printf "%.0fms", (b - a) * 1000 }')"
  fi

  if (( rc == 0 )); then
    printf '  port %-5s  %s  %s\n' "$port" "$(color_status ok "OPEN   ")" "$ms"
    dump_row ports "n:port=${port}" "s:state=open" "n:connect_ms=${ms%ms}"
    return 0
  fi
  FAILED=$((FAILED + 1))
  if (( rc == 124 )); then
    printf '  port %-5s  %s\n' "$port" "$(color_status bad "TIMEOUT (filtered or host down)")"
    dump_row ports "n:port=${port}" "s:state=timeout" "n:connect_ms="
    return 0
  fi
  local low=${err,,}
  case "$low" in
    *"connection refused"*)
      printf '  port %-5s  %s\n' "$port" \
        "$(color_status warn "REFUSED (host up, port closed)")"
      dump_row ports "n:port=${port}" "s:state=refused" "n:connect_ms="
      ;;
    *"name or service not known"*|*"temporary failure in name resolution"*|*"nodename nor servname"*)
      printf '  port %-5s  %s\n' "$port" "$(color_status bad "DNS FAIL (name did not resolve)")"
      dump_row ports "n:port=${port}" "s:state=dns_fail" "n:connect_ms="
      ;;
    *"no route to host"*|*"network is unreachable"*)
      printf '  port %-5s  %s\n' "$port" "$(color_status bad "UNREACHABLE (no route)")"
      dump_row ports "n:port=${port}" "s:state=unreachable" "n:connect_ms="
      ;;
    *)
      # Strip bash's "bash: line N:" noise; keep the useful tail.
      printf '  port %-5s  %s\n' "$port" "$(color_status bad "FAIL (${err##*: })")"
      dump_row ports "n:port=${port}" "s:state=fail" "n:connect_ms="
      ;;
  esac
}

dump_begin
header portcheck
VIA="$(via_for "$HOST")"
echo "host: ${HOST}  ports: ${PORTS[*]}  timeout: ${TIMEOUT}s${VIA:+  via: ${VIA}}"
multihomed_note "$VIA"
echo
echo "=== probes ==="
TESTED=0
catch_int
for p in "${PORTS[@]}"; do
  # A port never probed is unknown, not filtered. Counting it against the total
  # would report closed ports the tool never actually tried to reach.
  if interrupted; then
    printf '  port %-5s  %s\n' "$p" \
      "$(color_status warn "not probed (run interrupted)")"
    # No dump_row: an unprobed port has no state, and inventing one would put a
    # port the tool never reached into the evidence.
    continue
  fi
  prev_failed=$FAILED
  probe_port "$HOST" "$p"
  # Ctrl-C kills the connect in flight, so the line just printed reports the
  # signal, not the network. Discard the count: a cut-short probe is not a
  # filtered port.
  if interrupted; then
    FAILED=$prev_failed
    printf '  %s\n' \
      "$(color_status warn "^ that probe was cut short by the interrupt; result discarded")"
    continue
  fi
  TESTED=$((TESTED + 1))
done
release_int

if interrupted; then
  note "interrupted — ${TESTED} of ${#PORTS[@]} port(s) were probed"
fi

if (( TESTED == 0 )); then
  CODE=130
  verdict "interrupted before any port was probed; no reachability evidence collected." \
    "Re-run and allow at least one port to complete."
elif (( FAILED == 0 )); then
  CODE=0
  if interrupted; then
    verdict "all ${TESTED} port(s) probed connected; the rest were not tried." \
      "Re-run to completion before treating the service as reachable."
  else
    verdict "all ${#PORTS[@]} port(s) connected."
  fi
else
  CODE=2
  verdict "${FAILED} of ${TESTED} probed port(s) did not connect." \
    "REFUSED means the host answered (service down); TIMEOUT suggests filtering or an unreachable host."
fi

if [[ -n "$DUMP_PATH" ]]; then
  dump_str host "$HOST"
  dump_opt_str via "$VIA"
  dump_num timeout_s "$TIMEOUT"
  dump_num ports_failed "$FAILED"
  dump_num ports_probed "$TESTED"
  dump_num ports_total "${#PORTS[@]}"
  dump_bool interrupted "$(interrupted && echo true || echo false)"
  dump_write "$DUMP_PATH" portcheck "$(interrupted && echo 130 || echo "$CODE")" || true
fi
finish_with "$CODE"
