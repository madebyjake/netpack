#!/usr/bin/env bash
# splitloss — compare gateway vs WAN loss over a concurrent ping window
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/netpack.sh
source "${ROOT}/lib/netpack.sh"
# shellcheck source=../lib/netpack/parsers.sh
source "${ROOT}/lib/netpack/parsers.sh"

T=60
WAN=1.1.1.1
DIR=""
KEEP_LOGS=0
IFACE=""

usage() {
  cat <<'EOF'
splitloss — ping default gateway and a WAN target concurrently, then compare loss.

Localizes fault domain:
  gateway lossy                 -> access layer
  gateway clean, WAN lossy      -> uplink / path beyond the gateway
  both clean                    -> not indicated in this window

Also reports rtt min/avg/max/mdev per target (latency and jitter evidence;
compare an idle run against a run under planned load to show bufferbloat).
Runs of 120s or longer include a loss timeline: any 60s interval with loss is
listed with its wall-clock start, for correlating with incident reports.

Ctrl-C ends the window early: the pings print their partial summaries and the
comparison covers the completed portion.

On a multi-homed machine, -i binds both probes to IFACE and tests that
interface's own gateway instead of the default route's. The WAN leg is only
honest when a policy route (ip rule) steers IFACE's address out that uplink;
without one, replies would follow the main routing table and rp_filter can
drop them, so the WAN leg is reported untestable and the run exits 1 rather
than fabricating loss. Binding may require root on some systems.

Usage:
  splitloss [-i IFACE] [-t SECONDS] [-w WAN_TARGET] [-d DIR] [--dump FILE]

Options:
  -i IFACE         Bind probes to IFACE and test its gateway (multi-homed)
  -t SECONDS       Test duration (default: 60)
  -w WAN_TARGET    WAN ICMP target (default: 1.1.1.1)
  -d DIR           Keep logs in DIR (timestamped filenames; created if needed)
  --dump FILE      Write JSON evidence to FILE
  -h, --help       Show this help

Without -d, logs are written under a private temp directory and removed on exit
after the summary is printed. Use -d to retain logs for timeline correlation.

Exit codes:
  0  both targets clean (<=1% loss)
  1  usage, dependency, or probe failure; or the WAN leg was untestable via -i
  2  gateway loss (>1%)
  3  gateway clean, WAN loss (>1%)
EOF
}

if [[ "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

take_dump_opt "$@"
set -- "${NP_ARGS[@]+"${NP_ARGS[@]}"}"

while getopts ":i:t:w:d:h" opt; do
  case "$opt" in
    i) IFACE=$OPTARG ;;
    t) T=$OPTARG ;;
    w) WAN=$OPTARG ;;
    d) DIR=$OPTARG; KEEP_LOGS=1 ;;
    h) usage; exit 0 ;;
    *) usage >&2; exit 1 ;;
  esac
done
shift $((OPTIND - 1))
no_extra_args "$@"

require_uint duration "$T" 1
# Normalize to base 10: a validated "0120" is 120, but bash arithmetic would
# read the leading zero as octal and skip the loss timeline.
T=$((10#$T))
require_cmd ping ip

PING_BIND=()
WAN_SKIP=""
if [[ -n "$IFACE" ]]; then
  validate_iface "$IFACE"
  GW="$(iface_gateway "$IFACE")"
  [[ -n "$GW" ]] || die "no default route via ${IFACE}; its gateway is unknown"
  SRC="$(iface_ipv4 "$IFACE")"
  [[ -n "$SRC" ]] || die "no IPv4 address on ${IFACE}"
  PING_BIND=(-I "$IFACE")
  VIA=$IFACE
  # The gateway is on-link, so binding alone tests it honestly; only the WAN
  # leg needs a policy route.
  WAN_SKIP="$(uplink_unroutable "$IFACE" "$SRC" "$WAN")"
else
  GW="$(default_gateway)"
  [[ -n "$GW" ]] || die "no default gateway"
  VIA="$(via_for "$WAN")"
fi

if [[ "$KEEP_LOGS" -eq 1 ]]; then
  mkdir -p "$DIR"
  chmod 700 "$DIR" 2>/dev/null || true
else
  DIR="$(private_tmpdir splitloss)"
fi

# Per-run filenames so repeat runs into the same -d DIR never clobber evidence.
# Both legs share one claimed base, so a pair always belongs to the same run.
RUN_BASE="$(unique_path "${DIR}/$(date +%Y%m%d-%H%M%S)" -gw.log -wan.log)"
LOG_GW="${RUN_BASE}-gw.log"
LOG_WAN="${RUN_BASE}-wan.log"

cleanup() {
  if [[ "${CLEAN_TMP:-0}" -eq 1 && "$KEEP_LOGS" -eq 0 && -n "${DIR:-}" && -d "$DIR" ]]; then
    rm -rf "$DIR"
  fi
}
trap cleanup EXIT

dump_begin
header splitloss
echo "gateway: ${GW}  wan: ${WAN}  duration: ${T}s${VIA:+  via: ${VIA}}"
if [[ -n "$IFACE" ]]; then
  multihomed_note "${IFACE} (bound with -i)"
else
  multihomed_note "$VIA" "pass -i IFACE to target another uplink"
fi
if [[ -n "$WAN_SKIP" ]]; then
  warning "WAN leg untestable via ${IFACE}: ${WAN_SKIP}"
fi
# Wall-clock base for the loss timeline: seq N was sent ~N-1 seconds after this.
START_EPOCH="$(date +%s)"

# Ctrl-C goes to the whole foreground process group: each ping prints its
# partial summary and exits, and this shell must survive its interrupted
# wait(s) to parse those summaries. wait_bg re-waits while the child is
# still alive, so the recorded status is the ping's, not wait's 130.
catch_int
WAIT_RC=0
wait_bg() {
  local pid=$1
  while :; do
    WAIT_RC=0
    wait "$pid" || WAIT_RC=$?
    if (( WAIT_RC > 128 )) && kill -0 "$pid" 2>/dev/null; then
      continue
    fi
    return 0
  done
}

set +e
ping "${PING_BIND[@]+"${PING_BIND[@]}"}" -D -i 1 -w "$T" "$GW"  >"$LOG_GW"  2>&1 &
P1=$!
if [[ -z "$WAN_SKIP" ]]; then
  ping "${PING_BIND[@]+"${PING_BIND[@]}"}" -D -i 1 -w "$T" "$WAN" >"$LOG_WAN" 2>&1 &
  P2=$!
fi
wait_bg "$P1"
RC1=$WAIT_RC
RC2=0
if [[ -z "$WAN_SKIP" ]]; then
  wait_bg "$P2"
  RC2=$WAIT_RC
fi
set -e
release_int
if interrupted; then
  note "interrupted — summarizing the completed portion of the window"
fi

# ping returns 1 when some packets are lost but the run completed; 2+ is error.
if [[ ! -s "$LOG_GW" ]] || { [[ -z "$WAN_SKIP" && ! -s "$LOG_WAN" ]]; }; then
  echo "logs retained: ${DIR}" >&2
  die "ping produced empty logs (check permissions and connectivity)"
fi
if (( RC1 >= 2 || RC2 >= 2 )); then
  echo "logs retained: ${DIR}" >&2
  if [[ -n "$IFACE" ]]; then
    die "ping failed (gateway exit ${RC1}, wan exit ${RC2}); binding with -i may require root — re-run with sudo"
  fi
  die "ping failed (gateway exit ${RC1}, wan exit ${RC2})"
fi

gl="$(loss_pct "$LOG_GW")" || {
  echo "logs retained: ${DIR}" >&2
  die "could not parse gateway ping summary in ${LOG_GW}"
}
wl=""
if [[ -z "$WAN_SKIP" ]]; then
  wl="$(loss_pct "$LOG_WAN")" || {
    echo "logs retained: ${DIR}" >&2
    die "could not parse WAN ping summary in ${LOG_WAN}"
  }
fi

# "label (host): X% packet loss  rtt min/avg/max/mdev a/b/c/d ms" — rtt is
# omitted when the log has no summary (100% loss).
print_target() {
  local label=$1 host=$2 loss=$3 log=$4
  local stats rmin ravg rmax rmdev extra=""
  if stats="$(rtt_stats "$log")"; then
    IFS=$'\t' read -r rmin ravg rmax rmdev <<<"$stats"
    extra="  rtt min/avg/max/mdev ${rmin}/${ravg}/${rmax}/${rmdev} ms"
  fi
  printf '%-7s (%s): %s packet loss%s\n' "$label" "$host" "$(color_loss_pct "$loss")" "$extra"
}

bucket_clock() {
  local epoch=$((START_EPOCH + $1))
  # GNU date on the Debian target; -r fallback keeps dev boxes working.
  date -d "@${epoch}" +%H:%M:%S 2>/dev/null || date -r "$epoch" +%H:%M:%S
}

print_timeline() {
  local label=$1 log=$2
  local rows rc=0 off lost expect pct
  # bucket_loss exits non-zero on an unusable log; do not report that as clean.
  rows="$(bucket_loss "$log" 60)" || rc=$?
  if (( rc != 0 )); then
    echo "  ${label}: $(color_status warn "timeline unavailable (log not parseable)")"
    return 0
  fi
  if [[ -z "$rows" ]]; then
    echo "  ${label}: $(color_status ok "no lossy intervals")"
    return 0
  fi
  echo "  ${label}:"
  while IFS=$'\t' read -r off lost expect; do
    [[ -n "$off" ]] || continue
    pct="$(awk -v l="$lost" -v e="$expect" 'BEGIN { printf "%.1f", e ? l * 100 / e : 0 }')"
    printf '    %s  %s\n' "$(bucket_clock "$off")" \
      "$(color_status bad "${lost}/${expect} lost (${pct}%)")"
  done <<<"$rows"
}

# One row per target, carrying the same figures print_target rendered. rtt is
# null rather than 0 when the log has no summary line: at 100% loss the probes
# went out and nothing came back, and a zero would read as an instant reply.
dump_target() {
  local label=$1 host=$2 loss=$3 log=$4
  local stats rmin="" ravg="" rmax="" rmdev=""
  if stats="$(rtt_stats "$log")"; then
    IFS=$'\t' read -r rmin ravg rmax rmdev <<<"$stats"
    # rtt_stats prints "-" for mdev when ping omitted it.
    [[ "$rmdev" == "-" ]] && rmdev=""
  fi
  dump_row targets "s:target=${label}" "s:host=${host}" "b:measured=true" \
    "n:loss_pct=${loss}" "n:rtt_min_ms=${rmin}" "n:rtt_avg_ms=${ravg}" \
    "n:rtt_max_ms=${rmax}" "n:rtt_mdev_ms=${rmdev}"
}

# Buckets are lossy intervals only, matching the report. An empty list means a
# clean window; a bucket the run never reached is simply absent, which is why
# measured=false above carries the "not tested" signal instead.
dump_timeline() {
  local label=$1 log=$2 rows off lost expect
  rows="$(bucket_loss "$log" 60)" || return 0
  [[ -n "$rows" ]] || return 0
  while IFS=$'\t' read -r off lost expect; do
    [[ -n "$off" ]] || continue
    dump_row loss_timeline "s:target=${label}" "n:offset_s=${off}" \
      "n:lost=${lost}" "n:expected=${expect}"
  done <<<"$rows"
}

print_target gateway "$GW" "$gl" "$LOG_GW"
dump_target gateway "$GW" "$gl" "$LOG_GW"
if [[ -n "$WAN_SKIP" ]]; then
  printf '%-7s (%s): %s\n' wan "$WAN" "$(color_status warn "untestable via ${IFACE}")"
  # Every figure null: an untestable leg is unmeasured, and a 0% loss here
  # would put a path that was never probed into the evidence as clean.
  dump_row targets "s:target=wan" "s:host=${WAN}" "b:measured=false" \
    "n:loss_pct=" "n:rtt_min_ms=" "n:rtt_avg_ms=" \
    "n:rtt_max_ms=" "n:rtt_mdev_ms="
else
  print_target wan "$WAN" "$wl" "$LOG_WAN"
  dump_target wan "$WAN" "$wl" "$LOG_WAN"
fi

# For long runs, show when the loss happened, not just how much.
if (( T >= 120 )); then
  section "loss timeline (60s intervals, lossy only)"
  print_timeline gateway "$LOG_GW"
  dump_timeline gateway "$LOG_GW"
  if [[ -z "$WAN_SKIP" ]]; then
    print_timeline wan "$LOG_WAN"
    dump_timeline wan "$LOG_WAN"
  fi
  echo
fi

if [[ "$KEEP_LOGS" -eq 1 ]]; then
  if [[ -n "$WAN_SKIP" ]]; then
    echo "logs: ${LOG_GW}"
  else
    echo "logs: ${LOG_GW} ${LOG_WAN}"
  fi
else
  echo "logs: discarded after summary (pass -d DIR to retain)"
fi

# Enable temp cleanup only for successful interpretation paths.
CLEAN_TMP=1

# Ctrl-C is the normal stop for splitloss, so this is not an error here; it
# records that the window was shorter than -t asked for, which is what makes the
# loss percentages comparable to another run or not.
emit_dump() {
  local code=$1
  [[ -n "$DUMP_PATH" ]] || return 0
  dump_str gateway "$GW"
  dump_str wan "$WAN"
  dump_opt_str iface "$IFACE"
  dump_opt_str via "$VIA"
  dump_num duration_s "$T"
  dump_opt_str wan_untestable "$WAN_SKIP"
  dump_bool interrupted "$(interrupted && echo true || echo false)"
  dump_write "$DUMP_PATH" splitloss "$code" || true
}

if awk -v p="$gl" 'BEGIN { exit !(p > 1) }'; then
  verdict "loss to gateway indicates an access-layer problem.${WAN_SKIP:+ The WAN leg was untested.}" \
    "Inspect local switch/AP, cabling, and the gateway path."
  emit_dump 2
  finished
  exit 2
elif [[ -n "$WAN_SKIP" ]]; then
  verdict "gateway via ${IFACE} is clean; the WAN leg was untestable (${WAN_SKIP})." \
    "Add a policy route (ip rule) for ${SRC} to test this uplink end-to-end, or run without -i for the default path."
  emit_dump 1
  finished
  exit 1
elif awk -v p="$wl" 'BEGIN { exit !(p > 1) }'; then
  verdict "gateway is clean; WAN path shows loss." \
    "Inspect uplink, venue circuit, and upstream path evidence."
  emit_dump 3
  finished
  exit 3
else
  verdict "both targets were clean during this window." \
    "If the symptom was active, check application, server, or DNS layers."
  emit_dump 0
  finished
  exit 0
fi
