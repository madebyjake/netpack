#!/usr/bin/env bash
# ringcap — rotating packet capture ring for intermittent symptoms
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/netpack.sh
source "${ROOT}/lib/netpack.sh"
# shellcheck source=../lib/netpack/parsers.sh
source "${ROOT}/lib/netpack/parsers.sh"

IFACE=""
MB=20
N=10
FILT=""
DIR=""
SNAPLEN=96

usage() {
  cat <<'EOF'
ringcap — leave a fixed-size rotating capture running until interrupted.

When an intermittent symptom occurs, note the wall-clock time and inspect the
matching file in the ring.

Default snaplen is 96 (headers). Payloads are mostly omitted, but headers may
still identify hosts. Increase snaplen only when required.

Usage:
  ringcap -d DIR [-i IFACE] [-s FILE_MB] [-n FILES] [-f 'bpf'] [-S SNAPLEN]

Options:
  -d DIR         Output directory (required)
  -i IFACE       Capture interface (default: default-route iface)
  -s FILE_MB     Size of each ring file in MB (default: 20)
  -n FILES       Number of files in the ring (default: 10)
  -f BPF         Optional BPF filter
  -S SNAPLEN     Snapshot length in bytes (default: 96)
  -h, --help     Show this help

Requires root. Stop with Ctrl-C.
Analysis hints: tcp.analysis.retransmission, tcp.analysis.duplicate_ack,
icmp destination-unreachable.

Exit codes:
  0  ring stopped with capture files retained (Ctrl-C is the normal stop)
  1  usage, dependency, or permission error; tcpdump failed, or no files written
EOF
}

if [[ "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

while getopts ":i:s:n:d:f:S:h" opt; do
  case "$opt" in
    i) IFACE=$OPTARG ;;
    s) MB=$OPTARG ;;
    n) N=$OPTARG ;;
    d) DIR=$OPTARG ;;
    f) FILT=$OPTARG ;;
    S) SNAPLEN=$OPTARG ;;
    h) usage; exit 0 ;;
    *) usage >&2; exit 1 ;;
  esac
done
shift $((OPTIND - 1))
no_extra_args "$@"

[[ -n "$DIR" ]] || die "output directory required (-d DIR)"
require_uint "file size" "$MB" 1
require_uint "file count" "$N" 1
require_uint snaplen "$SNAPLEN" 1
IFACE="$(resolve_iface "${IFACE}")"
require_cmd tcpdump
require_root

mkdir -p "$DIR"
chmod 700 "$DIR" 2>/dev/null || true
ABS_DIR="$(cd "$DIR" && pwd)"

header ringcap
echo "iface: ${IFACE}"
# tcpdump appends the ring index after the name (cap.pcap0, cap.pcap1, ...).
echo "output: ${ABS_DIR}/cap.pcap*  ring ${N}x${MB}MB  snaplen ${SNAPLEN}"
echo "filter: ${FILT:-<none>}"
echo "Note wall-clock time when the symptom occurs. Stop with Ctrl-C."

cd "$ABS_DIR"
# Not exec: the run has to come back here to close the report, so the evidence
# carries its own end time like every other tool. Ctrl-C reaches tcpdump
# through the process group; bash defers this trap until it exits.
INTERRUPTED=0
trap 'INTERRUPTED=1' INT
RC=0
# Stay root after opening the device so -C rotation can create files in this
# root-owned 0700 directory (Debian/Ubuntu tcpdump otherwise drops to tcpdump).
if [[ -n "$FILT" ]]; then
  tcpdump -Z root -i "$IFACE" -s "$SNAPLEN" -C "$MB" -W "$N" -w "cap.pcap" "$FILT" || RC=$?
else
  tcpdump -Z root -i "$IFACE" -s "$SNAPLEN" -C "$MB" -W "$N" -w "cap.pcap" || RC=$?
fi
trap - INT

# tcpdump killed by SIGINT reports 128+2; Ctrl-C is the normal stop here.
if (( INTERRUPTED )) || (( RC == 130 )); then
  RC=0
fi

FILES="$(find . -maxdepth 1 -name 'cap.pcap*' -type f | wc -l | tr -d ' ')"
echo
section "ring"
if (( FILES > 0 )); then
  printf '  %s file(s) in %s\n' "$FILES" "$ABS_DIR"
else
  echo "  $(color_status warn "no capture files written")"
fi

if (( RC != 0 )); then
  verdict "tcpdump exited ${RC} before the ring was stopped." \
    "Check interface state, disk space, and the BPF filter syntax."
  finished
  exit 1
fi
if (( FILES == 0 )); then
  verdict "capture stopped with no files written." \
    "Confirm traffic was present on ${IFACE} and that the filter matches it."
  finished
  exit 1
fi
verdict "capture ring stopped; ${FILES} file(s) retained in ${ABS_DIR}." \
  "Open the file matching the symptom's wall-clock time in Wireshark or tshark."
finished
