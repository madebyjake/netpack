#!/usr/bin/env python3
"""linkstat — sample interface counters and classify physical vs congestion signals."""

from __future__ import annotations

import subprocess
import sys
import time
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))

from netpack import cli, link, report, verdicts
from netpack.net import C_LOCALE, NetError, is_wireless, resolve_iface

EXIT_OK = 0
EXIT_ERROR = 1
EXIT_PHYSICAL = 2
EXIT_CONGESTION = 3
EXIT_FLAP = 4
EXIT_INTERRUPT = 130

COUNTERS = [
    "rx_packets",
    "tx_packets",
    "rx_errors",
    "tx_errors",
    "rx_dropped",
    "tx_dropped",
    "rx_crc_errors",
    "rx_fifo_errors",
    "tx_fifo_errors",
    "collisions",
]

BYTE_COUNTERS = ["rx_bytes", "tx_bytes"]

ERROR_KEYS = {
    "rx_errors",
    "tx_errors",
    "rx_crc_errors",
    "collisions",
}
DROP_KEYS = {
    "rx_dropped",
    "tx_dropped",
    "rx_fifo_errors",
    "tx_fifo_errors",
}


def _usage() -> str:
    return """\
linkstat — sample interface counters over an interval and classify growth.

Read-only. Does not generate traffic. Also reports rx/tx utilization over the
window so drop growth can be read against load (drops under load suggest
congestion; drops while idle suggest policy or misconfiguration).

  errors / crc / collisions growing  -> physical layer (cable, NIC, duplex)
  dropped / fifo growing             -> congestion, buffering, or policy
  carrier_changes growing            -> link flaps (ethernet); informational on Wi-Fi

On wired links the report also states speed/duplex, Energy Efficient Ethernet
and flow control. EEE is called out because low-power idle adds wake latency
and jitter, which destabilizes real-time media clocking (Dante/AES67, PTP) and
VoIP. These are settings, not counters, so they never change the exit code.

When the counters point at the physical layer, `cabletest` measures the cable
itself.

Usage:
  linkstat [-i IFACE] [-t SECONDS] [--dump FILE]

Options:
  -i, --iface IFACE   Interface (default: default-route iface)
  -t, --timeout SEC   Sample window in seconds (default: 10)
  --dump FILE         Write JSON evidence to FILE
  -h, --help          Show this help

Exit codes:
  0  no error or drop growth
  1  usage or interface error
  2  physical-layer counter growth
  3  congestion/drop counter growth
  4  ethernet carrier flaps (without error growth)
  130  interrupted; the report and dump cover the shortened window

Ctrl-C ends the sample early and still reports: the counters gathered so far
are the evidence, and rates are computed against the window that elapsed.
"""


def read_counter(iface: str, name: str) -> int:
    path = Path(f"/sys/class/net/{iface}/statistics/{name}")
    try:
        return int(path.read_text(encoding="utf-8").strip())
    except (FileNotFoundError, ValueError, OSError):
        return 0


def snap_counters(iface: str) -> dict[str, int]:
    return {name: read_counter(iface, name) for name in COUNTERS}


def snap_bytes(iface: str) -> dict[str, int]:
    return {name: read_counter(iface, name) for name in BYTE_COUNTERS}


def mbit_s(byte_delta: int, seconds: float) -> float:
    return byte_delta * 8 / seconds / 1e6


def read_carrier_changes(iface: str) -> int:
    path = Path(f"/sys/class/net/{iface}/carrier_changes")
    try:
        return int(path.read_text(encoding="utf-8").strip())
    except (FileNotFoundError, ValueError, OSError):
        return 0


def _run(cmd: list[str]) -> str | None:
    """Command stdout, or None when it is missing or exits non-zero."""
    try:
        return subprocess.check_output(
            cmd, stderr=subprocess.DEVNULL, text=True, env=C_LOCALE
        )
    except (subprocess.CalledProcessError, FileNotFoundError, OSError):
        return None


def link_info(iface: str) -> dict[str, str]:
    info: dict[str, str] = {}
    if is_wireless(iface):
        if not _have("iw"):
            info["note"] = "iw not installed"
            return info
        out = _run(["iw", "dev", iface, "link"])
        if out is None:
            info["note"] = "iw link query failed"
            return info
        return link.parse_iw_link(out)

    if not _have("ethtool"):
        info["note"] = "ethtool not installed"
        return info
    out = _run(["ethtool", iface])
    if out is None:
        info["note"] = "ethtool query failed"
        return info
    info.update(link.parse_ethtool(out))

    # EEE and flow control are settings rather than counters, but both change
    # how a link behaves under real-time load, so they belong with the link
    # facts. Older ethtool lacks these queries; absence is simply not reported.
    eee_out = _run(["ethtool", "--show-eee", iface])
    if eee_out is not None:
        status = link.parse_eee(eee_out)
        if status:
            info["eee"] = status
    pause_out = _run(["ethtool", "-a", iface])
    if pause_out is not None:
        pause = link.format_pause(link.parse_pause(pause_out))
        if pause:
            info["pause"] = pause
    return info


def _have(cmd: str) -> bool:
    from shutil import which

    return which(cmd) is not None


def print_report(
    iface: str,
    window: float,
    deltas: dict[str, int],
    byte_deltas: dict[str, int],
    flaps: int,
    info: dict[str, str],
    wireless: bool,
    interrupted: bool = False,
) -> int:
    report.header("linkstat")
    if interrupted:
        print(f"iface: {iface}  sample: {window:.1f}s (interrupted)")
    else:
        print(f"iface: {iface}  sample: {window:g}s")

    report.section("link")
    if info:
        for key, val in info.items():
            if key == "eee" and link.eee_is_enabled(val):
                print(f"  {key}: {report.color_status('warn', val)}")
            else:
                print(f"  {key}: {val}")
    else:
        print("  (no link details available)")
    if link.eee_is_enabled(info.get("eee")):
        report.note(
            "Energy Efficient Ethernet is negotiated on this link. EEE lets the "
            "PHY enter low-power idle between frames, which adds wake latency and "
            "jitter — a known cause of clock instability for real-time media "
            "(Dante/AES67, PTP) and of jitter for VoIP. Disable it on ports "
            "carrying those streams."
        )

    report.section("utilization")
    for name in BYTE_COUNTERS:
        label = name.split("_")[0]
        print(
            f"  {label}: {mbit_s(byte_deltas[name], window):.2f} Mbit/s "
            f"({byte_deltas[name] / 1e6:.1f} MB)"
        )

    report.section("counter deltas")
    print(f"  {'counter':<16} {'delta':>12}")
    err = 0
    drp = 0
    for name in COUNTERS:
        d = max(0, deltas[name])  # ignore wrap/teardown negatives
        delta = deltas[name]
        if name in ERROR_KEYS and d > 0:
            delta_s = report.color_status("bad", f"{delta:12d}")
            print(f"  {name:<16} {delta_s}")
        elif name in DROP_KEYS and d > 0:
            delta_s = report.color_status("warn", f"{delta:12d}")
            print(f"  {name:<16} {delta_s}")
        else:
            print(f"  {name:<16} {delta:12d}")
        if name in ERROR_KEYS:
            err += d
        if name in DROP_KEYS:
            drp += d

    if flaps > 0:
        label = "carrier_changes (wifi; informational)" if wireless else "carrier_changes"
        flap_s = (
            report.color_status("warn", f"{flaps:12d}")
            if wireless
            else report.color_status("bad", f"{flaps:12d}")
        )
        print(f"  {label:<16} {flap_s}")

    if interrupted:
        report.warning(f"interrupted after {window:.1f}s; counters cover that window only")

    # Reaching here means the physical and non-wireless-flap branches did not
    # fire, so this is exactly the original condition for the note.
    if err == 0 and flaps > 0 and wireless:
        report.note(
            f"carrier_changes increased by {flaps} on a wireless interface "
            "(often roam/reassoc; not classified as a flap fault)."
        )

    v = verdicts.link_counters(err, drp, flaps, wireless, window, interrupted)
    report.verdict(v.message, v.next_step)
    return v.code


def main(argv: list[str] | None = None) -> int:
    parser = cli.ArgumentParser(prog="linkstat", add_help=False)
    parser.add_argument("-i", "--iface")
    parser.add_argument("-t", "--timeout", type=float, default=10.0)
    parser.add_argument("--dump")
    parser.add_argument("-h", "--help", action="store_true")
    args = parser.parse_args(argv)

    if args.help:
        print(_usage(), end="")
        return EXIT_OK

    timeout = args.timeout
    if timeout <= 0:
        print("error: timeout must be positive", file=sys.stderr)
        return EXIT_ERROR

    try:
        iface = resolve_iface(args.iface)
    except NetError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return EXIT_ERROR

    stats_dir = Path(f"/sys/class/net/{iface}/statistics")
    if not stats_dir.is_dir():
        print(f"error: statistics not available for {iface}", file=sys.stderr)
        return EXIT_ERROR

    wireless = is_wireless(iface)
    info = link_info(iface)
    before = snap_counters(iface)
    bytes_before = snap_bytes(iface)
    carrier_before = read_carrier_changes(iface)
    report.progress(f"sampling {timeout:g}s on {iface} ...")
    # Ctrl-C ends the window early; the counters gathered so far are the
    # evidence. Rates use the window that elapsed, not the one requested —
    # billing a 4s sample as 30s divides them by seven.
    interrupted = False
    sample_start = time.monotonic()
    try:
        time.sleep(timeout)
    except KeyboardInterrupt:
        interrupted = True
    window = max(time.monotonic() - sample_start, 0.001) if interrupted else timeout
    after = snap_counters(iface)
    bytes_after = snap_bytes(iface)
    carrier_after = read_carrier_changes(iface)
    deltas = {k: after[k] - before[k] for k in COUNTERS}
    byte_deltas = {k: max(0, bytes_after[k] - bytes_before[k]) for k in BYTE_COUNTERS}
    flaps = max(0, carrier_after - carrier_before)

    code = print_report(
        iface, window, deltas, byte_deltas, flaps, info, wireless, interrupted
    )
    if interrupted:
        code = EXIT_INTERRUPT

    if args.dump:
        payload: dict[str, Any] = {
            "tool": "linkstat",
            "iface": iface,
            "timeout_s": window,
            "interrupted": interrupted,
            "wireless": wireless,
            "link": info,
            "before": before,
            "after": after,
            "deltas": deltas,
            "bytes_before": bytes_before,
            "bytes_after": bytes_after,
            "byte_deltas": byte_deltas,
            "rx_mbit_s": round(mbit_s(byte_deltas["rx_bytes"], timeout), 3),
            "tx_mbit_s": round(mbit_s(byte_deltas["tx_bytes"], timeout), 3),
            "carrier_changes_delta": flaps,
            "assessment_code": code,
        }
        report.emit_dump(args.dump, payload)

    report.finished()
    return code


if __name__ == "__main__":
    sys.exit(main())
