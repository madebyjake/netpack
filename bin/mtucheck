#!/usr/bin/env bash
# mtucheck — probe path MTU to gateway and a WAN target
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/netpack.sh
source "${ROOT}/lib/netpack.sh"
# shellcheck source=../lib/netpack/parsers.sh
source "${ROOT}/lib/netpack/parsers.sh"

WAN=1.1.1.1
MAX=1500
MIN=68

usage() {
  cat <<'EOF'
mtucheck — find the largest ICMP payload that reaches gateway and WAN without fragmentation.

Detects classic path MTU black holes (small pings work; large transfers stall).
Uses ping Do-Not-Fragment probes. Low traffic; safe for planned field checks.

On a multi-homed machine, -i binds the probes to IFACE and tests that
interface's own gateway instead of the default route's. The WAN leg is only
honest when a policy route (ip rule) steers IFACE's address out that uplink;
without one it is reported untestable and the run exits 1. The informational
tracepath section is skipped under -i (tracepath cannot bind). Binding may
require root on some systems.

Usage:
  mtucheck [-i IFACE] [-w WAN_TARGET] [-m MAX_SIZE] [--dump FILE]

Options:
  -i IFACE        Bind probes to IFACE and test its gateway (multi-homed)
  -w WAN_TARGET   WAN ICMP target (default: 1.1.1.1)
  -m MAX_SIZE     Maximum total IP size to test (default: 1500)
  --dump FILE     Write JSON evidence to FILE
  -h, --help      Show this help

Exit codes:
  0  gateway and WAN support a full-size path near MAX
  1  usage, dependency, or probe error; or the WAN leg was untestable via -i
  2  reduced MTU detected on gateway or WAN path
  130  interrupted; sizes reported are a lower bound

Ctrl-C stops the search and still reports. An unconverged binary search proves
only that the sizes shown passed, so the figure is a floor and never a reduced
MTU: sizes above it were not probed, not blocked.
EOF
}

if [[ "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

IFACE=""

take_dump_opt "$@"
set -- "${NP_ARGS[@]+"${NP_ARGS[@]}"}"

while getopts ":i:w:m:h" opt; do
  case "$opt" in
    i) IFACE=$OPTARG ;;
    w) WAN=$OPTARG ;;
    m) MAX=$OPTARG ;;
    h) usage; exit 0 ;;
    *) usage >&2; exit 1 ;;
  esac
done
shift $((OPTIND - 1))
no_extra_args "$@"

require_uint "max size" "$MAX" 100
# Normalize to base 10: a validated "0100" is 100, but bash arithmetic would
# read the leading zero as octal.
MAX=$((10#$MAX))
require_cmd ping ip awk

PING_BIND=()
WAN_SKIP=""
if [[ -n "$IFACE" ]]; then
  validate_iface "$IFACE"
  GW="$(iface_gateway "$IFACE")"
  [[ -n "$GW" ]] || die "no default route via ${IFACE}; its gateway is unknown"
  SRC="$(iface_ipv4 "$IFACE")"
  [[ -n "$SRC" ]] || die "no IPv4 address on ${IFACE}"
  PING_BIND=(-I "$IFACE")
  VIA=$IFACE
  # The gateway is on-link, so binding alone tests it honestly; only the WAN
  # leg needs a policy route.
  WAN_SKIP="$(uplink_unroutable "$IFACE" "$SRC" "$WAN")"
else
  GW="$(default_gateway)"
  [[ -n "$GW" ]] || die "no default gateway"
  VIA="$(via_for "$WAN")"
fi

# Linux ping: -M do (DF), -s payload size. IP+ICMP headers ≈ 28 bytes for IPv4.
# Working total size ≈ payload + 28.
# Accept size if any of two probes succeed so a single drop does not shrink MTU.
ping_df() {
  local host=$1
  local payload=$2
  pulse "${host}: DF probe, payload ${payload}"
  ping "${PING_BIND[@]+"${PING_BIND[@]}"}" -c2 -W1 -M "do" -s "$payload" "$host" \
    >/dev/null 2>&1
}

largest_ok() {
  local host=$1
  local lo=$MIN
  local hi=$((MAX - 28))
  local best=0 mid
  if (( hi < lo )); then
    hi=$lo
  fi
  # Confirm small size works
  if ! ping_df "$host" "$lo"; then
    # SC2119: pulse_done's argument is an optional final message, not wanted here.
    # shellcheck disable=SC2119
    pulse_done
    echo "0"
    return 1
  fi
  best=$lo
  # An interrupted search has not converged, but every size in `best` was proved
  # to pass, so the figure stands as a lower bound rather than as the answer.
  # The caller marks it as one; it must never be printed as the path MTU.
  while (( lo <= hi )) && ! interrupted; do
    mid=$(( (lo + hi) / 2 ))
    if ping_df "$host" "$mid"; then
      best=$mid
      lo=$((mid + 1))
    else
      hi=$((mid - 1))
    fi
  done
  # shellcheck disable=SC2119
  pulse_done
  echo "$best"
}

dump_begin
header mtucheck
echo "max: ${MAX}  gateway: ${GW}  wan: ${WAN}${VIA:+  via: ${VIA}}"
if [[ -n "$IFACE" ]]; then
  multihomed_note "${IFACE} (bound with -i)"
else
  multihomed_note "$VIA" "pass -i IFACE to target another uplink"
fi
if [[ -n "$WAN_SKIP" ]]; then
  warning "WAN leg untestable via ${IFACE}: ${WAN_SKIP}"
fi
echo

# tracepath follows the routing table and cannot bind, so under -i it would
# describe a different path than the probes; skip it rather than mislead.
if [[ -z "$IFACE" ]] && command -v tracepath >/dev/null 2>&1; then
  echo "=== tracepath (informational) ==="
  tracepath -n "$GW" 2>/dev/null | tail -n 5 || true
  echo
  tracepath -n "$WAN" 2>/dev/null | tail -n 5 || true
  echo
fi

echo "=== DF ping binary search ==="
catch_int
gw_payload="$(largest_ok "$GW")" || true
wan_payload=""
WAN_UNPROBED=""
if [[ -z "$WAN_SKIP" ]]; then
  # A WAN leg the run never started is unmeasured, not blocked: leaving it at 0
  # would classify as "DF probes failed" and name a black hole that was never
  # looked for.
  if interrupted; then
    WAN_UNPROBED=1
  else
    wan_payload="$(largest_ok "$WAN")" || true
  fi
fi
release_int

gw_total="$(mtu_total "${gw_payload:-0}")"
wan_total="$(mtu_total "${wan_payload:-0}")"

threshold=$((MAX - 40))
# Expect near-full size; allow small header/tunnel slack
color_mtu() {
  local total=$1
  if (( total == 0 )); then
    color_status bad "0"
  elif (( total < threshold )); then
    color_status warn "$total"
  else
    color_status ok "$total"
  fi
}

# A leg's state, not just its number. "0 bytes" and "never probed" are different
# findings that a bare integer cannot tell apart: blocked DF probes are a real
# result, an unprobed leg is the absence of one.
#   measured   the binary search returned a size that passed
#   blocked    probes ran and none succeeded
#   not_probed the leg was skipped (unroutable binding, or interrupted first)
GW_STATE=measured
if (( gw_total == 0 )); then
  GW_STATE=$(interrupted && echo not_probed || echo blocked)
fi
WAN_STATE=measured
if [[ -n "$WAN_SKIP" ]]; then
  WAN_STATE=untestable_via_iface
elif [[ -n "$WAN_UNPROBED" ]]; then
  WAN_STATE=not_probed
elif (( wan_total == 0 )); then
  WAN_STATE=$(interrupted && echo not_probed || echo blocked)
fi

# Every exit path below has already printed a report, so each writes evidence
# too — an interrupted or untestable run still has to leave a file behind.
emit_dump() {
  local code=$1
  [[ -n "$DUMP_PATH" ]] || return 0
  dump_str gateway "$GW"
  dump_str wan "$WAN"
  dump_opt_str iface "$IFACE"
  dump_opt_str via "$VIA"
  dump_num max_size_bytes "$MAX"
  dump_num threshold_bytes "$threshold"
  dump_str gw_state "$GW_STATE"
  dump_str wan_state "$WAN_STATE"
  # Sizes only when the leg was actually measured; null otherwise, so a
  # consumer cannot read an unprobed path as a zero-byte MTU.
  if [[ "$GW_STATE" == measured ]]; then
    dump_num gw_payload_bytes "$gw_payload"
    dump_num gw_mtu_bytes "$gw_total"
  else
    dump_num gw_payload_bytes ""
    dump_num gw_mtu_bytes ""
  fi
  if [[ "$WAN_STATE" == measured ]]; then
    dump_num wan_payload_bytes "$wan_payload"
    dump_num wan_mtu_bytes "$wan_total"
  else
    dump_num wan_payload_bytes ""
    dump_num wan_mtu_bytes ""
  fi
  # An interrupted search proves a floor, not the path MTU. Without this a
  # consumer would read the lower bound as a converged measurement.
  dump_bool converged "$(interrupted && echo false || echo true)"
  dump_bool interrupted "$(interrupted && echo true || echo false)"
  dump_write "$DUMP_PATH" mtucheck "$code" || true
}

bound=""
if interrupted; then
  bound=" — at least this, search did not converge"
fi

printf 'gateway (%s): largest OK payload %s (approx IP size %s)%s\n' \
  "$GW" "${gw_payload:-0}" "$(color_mtu "$gw_total")" "$bound"
if [[ -n "$WAN_SKIP" ]]; then
  printf 'wan     (%s): %s\n' "$WAN" "$(color_status warn "untestable via ${IFACE}")"
elif [[ -n "$WAN_UNPROBED" ]]; then
  printf 'wan     (%s): %s\n' "$WAN" "$(color_status warn "not probed — run interrupted")"
else
  printf 'wan     (%s): largest OK payload %s (approx IP size %s)%s\n' \
    "$WAN" "${wan_payload:-0}" "$(color_mtu "$wan_total")" "$bound"
fi

# An unconverged search proves a floor, never a ceiling: the sizes above `best`
# were simply never tried, so nothing here can be called a black hole.
if interrupted; then
  note "interrupted — sizes above those shown were never probed"
  if (( gw_total == 0 )); then
    verdict "interrupted before any DF probe succeeded; no MTU evidence collected." \
      "Re-run and let the gateway leg complete."
  else
    verdict "the gateway path passed DF probes up to approximately ${gw_total} bytes before the run was interrupted." \
      "This is a lower bound, not the path MTU. Re-run to completion to find where it stops."
  fi
  emit_dump 130
  finished
  exit 130
fi

# A skipped WAN leg is unmeasured, not 0 (0 would classify as blocked), so the
# verdict is drawn from the gateway measurement alone.
if [[ -n "$WAN_SKIP" ]]; then
  if (( gw_total == 0 )); then
    emit_dump 1
    die "DF probes to the gateway failed via ${IFACE} (ICMP blocked, or binding may require root — re-run with sudo)"
  elif (( gw_total < threshold )); then
    verdict "reduced MTU on the gateway path via ${IFACE}; WAN leg untested." \
      "Check tunnels, PPPoE, and firewall DF handling on this uplink."
    emit_dump 2
    finished
    exit 2
  else
    verdict "gateway path via ${IFACE} accepted near-full-size DF probes; the WAN leg was untestable (${WAN_SKIP})." \
      "Add a policy route (ip rule) for ${SRC} to test this uplink end-to-end, or run without -i for the default path."
    emit_dump 1
    finished
    exit 1
  fi
fi

case "$(classify_mtu "$threshold" "$gw_total" "$wan_total")" in
  blocked)
    emit_dump 1
    if [[ -n "$IFACE" ]]; then
      die "DF probes failed to gateway and WAN via ${IFACE} (ICMP blocked, or binding may require root — re-run with sudo)"
    fi
    die "DF probes failed to gateway and WAN (ICMP blocked or no route)"
    ;;
  reduced)
    verdict "reduced path MTU detected (or ICMP DF probes blocked beyond a size)." \
      "Check tunnels, PPPoE, and firewall DF handling; compare gateway vs WAN sizes."
    emit_dump 2
    finished
    exit 2
    ;;
  *)
    verdict "gateway and WAN accepted near-full-size DF probes."
    emit_dump 0
    finished
    exit 0
    ;;
esac
