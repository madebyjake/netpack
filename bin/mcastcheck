#!/usr/bin/env python3
"""mcastcheck — verify multicast group delivery (IGMP snooping, Dante/NDI paths)."""

from __future__ import annotations

import ipaddress
import socket
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))

from netpack import cli, report
from netpack.mcast import (
    HEADER_LEN,
    LIVE_MEDIA_RANGE,
    ProbeStats,
    Source,
    decode_probe,
    encode_probe,
    in_live_media_range,
)
from netpack.net import NetError, iface_ipv4, resolve_iface

EXIT_OK = 0
EXIT_ERROR = 1
EXIT_NONE = 2
EXIT_LOSS = 3
EXIT_INTERRUPT = 130

DEFAULT_GROUP = "239.192.77.77"
DEFAULT_PORT = 7788
DEFAULT_TIMEOUT = 10.0
DEFAULT_COUNT = 500
DEFAULT_RATE = 50
DEFAULT_SIZE = 200
DEFAULT_TTL = 1

# dest -> (mode it belongs to, flag text for the error message)
MODE_OPTIONS = {
    "timeout": ("recv", "-t/--timeout"),
    "count": ("send", "-c/--count"),
    "rate": ("send", "-r/--rate"),
    "size": ("send", "-s/--size"),
    "ttl": ("send", "-T/--ttl"),
}


def _usage() -> str:
    return """\
mcastcheck — verify multicast group delivery (IGMP snooping, Dante/NDI paths).

recv joins GROUP:PORT and reports what arrives: per-source packet and bit
rates for any traffic (Dante flows, NDI multicast, sACN), plus one-way loss,
duplicates, and jitter when the traffic comes from 'mcastcheck send'.
Joining makes IGMP-snooping switches forward the group to this port — that
forwarding path is exactly what is under test.

send transmits sequence-numbered probe datagrams to GROUP:PORT. Default TTL 1
keeps probes on the local L2 segment; raise -T only for routed multicast.
At the defaults send is light (~80 kbit/s); pushed toward the limits
(-r 5000 -s 1472 is ~59 Mbit/s of multicast) it is a load generator — treat
that as a planned test.

Pair workflow (one-way delivery proof, like testsrv/testcli):
  receiving side:  mcastcheck recv
  sending side:    mcastcheck send

Verify a live production flow reaches this drop (passive apart from the join):
  mcastcheck recv -g 239.255.12.34 -p 4321 -t 10

The default group/port (239.192.77.77:7788) sits in the RFC 2365
organization-local scope, deliberately outside 239.255.0.0/16 — the range Dante
allocates media flows from by default. 'send' refuses that range without -y,
because transmitting into a group carrying live audio disrupts it. The check
covers the common default only; multicast addresses are configurable, so
confirm a group is unused before sending to it.

Options are mode-specific and are rejected rather than ignored when they do not
apply: -t belongs to recv, and -c/-r/-s/-T to send.

Usage:
  mcastcheck [recv] [-g GROUP] [-p PORT] [-i IFACE] [-t SECONDS] [--dump FILE]
  mcastcheck send  [-g GROUP] [-p PORT] [-i IFACE] [-c COUNT] [-r PPS]
                   [-s BYTES] [-T TTL] [-y] [--dump FILE]

Options:
  -g, --group ADDR    Multicast group (default: 239.192.77.77)
  -p, --port PORT     UDP port (default: 7788)
  -i, --iface IFACE   Interface (default: kernel default multicast route)
  -t, --timeout SEC   recv: listen window; Ctrl-C ends it early (default: 10)
  -c, --count N       send: probe count (default: 500)
  -r, --rate PPS      send: probes per second (default: 50)
  -s, --size BYTES    send: datagram size (default: 200)
  -T, --ttl TTL       send: multicast TTL (default: 1 = local segment only)
  -y, --yes           send: confirm sending into 239.255.0.0/16
  --dump FILE         Write JSON evidence to FILE
  -h, --help          Show this help

Exit codes:
  0  recv: traffic received (probe loss <= 1%) / send: all probes sent
  1  usage, socket, or interface error (includes a refused media-range send)
  2  recv: no datagrams within the window
  3  recv: probe traffic with > 1% loss
  130  send interrupted mid-stream (recv treats Ctrl-C as end-of-window).
       The report and --dump evidence are still written.
"""


# Rate accounting lives on Source (lib/netpack/mcast.py) so it is unit-testable
# without a socket, per the lib/bin split.


def print_sources(sources: dict[tuple[str, int], Source], elapsed: float) -> None:
    report.section(f"sources ({len(sources)})")
    if not sources:
        print(f"  ({report.color_status('bad', 'none')})")
        return
    by_traffic = sorted(sources.items(), key=lambda kv: kv[1].packets, reverse=True)
    for (ip, port), entry in by_traffic:
        rate = entry.rate_mbit_s(elapsed)
        avg = entry.bytes // max(entry.packets, 1)
        line = (
            f"  {ip}:{port}  {entry.packets} pkts  "
            f"{rate:.2f} Mbit/s  avg {avg} B"
        )
        if entry.probe is not None:
            s = entry.probe.summary()
            loss = f"{s['loss_pct']}%"
            loss_c = report.color_status("bad" if s["loss_pct"] > 1 else "ok", loss)
            line += (
                f"  probe: loss {loss_c} ({s['received']}/{s['expected']}), "
                f"jitter {s['jitter_ms']} ms, dup {s['duplicates']}"
            )
        print(line)


def run_recv(
    group: str,
    port: int,
    iface_label: str,
    iface_ip: str | None,
    window: float,
    dump: str | None,
) -> int:
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)
    sources: dict[tuple[str, int], Source] = {}
    start = time.monotonic()
    try:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            # Binding the group address filters other traffic on the port.
            sock.bind((group, port))
        except OSError:
            sock.bind(("", port))
        mreq = socket.inet_aton(group) + socket.inet_aton(iface_ip or "0.0.0.0")
        sock.setsockopt(socket.IPPROTO_IP, socket.IP_ADD_MEMBERSHIP, mreq)
        sock.settimeout(0.5)
        report.progress(
            f"listening {window:g}s on {group}:{port} (Ctrl-C ends the window early) ..."
        )
        deadline = start + window
        try:
            while time.monotonic() < deadline:
                try:
                    data, addr = sock.recvfrom(65535)
                except TimeoutError:
                    continue
                now = time.monotonic()
                key = (addr[0], addr[1])
                entry = sources.get(key)
                if entry is None:
                    entry = Source(first=now, last=now)
                    sources[key] = entry
                entry.last = now
                entry.packets += 1
                entry.bytes += len(data)
                probe = decode_probe(data)
                if probe is not None:
                    if entry.probe is None:
                        entry.probe = ProbeStats()
                    entry.probe.add(probe[0], probe[1], now)
        except KeyboardInterrupt:
            pass  # end the window early and report what was seen
        elapsed = max(time.monotonic() - start, 0.001)
    except OSError as exc:
        print(
            f"error: {exc} (multicast join failed; check interface and group)",
            file=sys.stderr,
        )
        return EXIT_ERROR
    finally:
        sock.close()

    report.header("mcastcheck")
    print(f"mode: recv  group: {group}:{port}  iface: {iface_label}  window: {elapsed:.1f}s")
    print_sources(sources, elapsed)

    probe_losses = [
        e.probe.summary()["loss_pct"] for e in sources.values() if e.probe is not None
    ]
    worst = max(probe_losses) if probe_losses else None

    if not sources:
        code = EXIT_NONE
        report.verdict(
            f"no multicast datagrams for {group}:{port} within {elapsed:.0f}s.",
            "Suspect IGMP snooping without a querier, wrong VLAN, or no active "
            "sender; run 'mcastcheck send' from the far side to test the path.",
        )
    elif worst is not None and worst > 1:
        code = EXIT_LOSS
        report.verdict(
            f"probe loss {worst}% on the multicast path.",
            "Compare with unicast loss (udp-loss, splitloss); multicast-only loss "
            "points at IGMP snooping, the querier, or switch multicast limits.",
        )
    elif worst is not None:
        code = EXIT_OK
        report.verdict(
            f"{len(sources)} source(s); probe delivery clean (worst loss {worst}%)."
        )
    else:
        code = EXIT_OK
        report.verdict(
            f"{len(sources)} source(s) delivering to {group}:{port}.",
            "Check the rates above against the expected flow (Dante/NDI/sACN).",
        )

    if dump:
        payload = {
            "tool": "mcastcheck",
            "mode": "recv",
            "group": group,
            "port": port,
            "window_s": round(elapsed, 1),
            "sources": [
                {
                    "ip": ip,
                    "port": sport,
                    "packets": e.packets,
                    "bytes": e.bytes,
                    "mbit_s": round(e.rate_mbit_s(elapsed), 3),
                    "probe": e.probe.summary() if e.probe is not None else None,
                }
                for (ip, sport), e in sources.items()
            ],
            "assessment_code": code,
        }
        path = report.write_dump(dump, payload)
        print(f"dump: {path}")

    report.finished()
    return code


def run_send(
    group: str,
    port: int,
    iface_label: str,
    iface_ip: str | None,
    count: int,
    rate: int,
    size: int,
    ttl: int,
    dump: str | None,
) -> int:
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)
    interrupted = False
    sent = 0
    sent_bytes = 0
    try:
        sock.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, ttl)
        if iface_ip:
            sock.setsockopt(
                socket.IPPROTO_IP, socket.IP_MULTICAST_IF, socket.inet_aton(iface_ip)
            )
        report.progress(
            f"sending {count} probes to {group}:{port} at {rate}/s "
            f"(~{count / rate:.0f}s) ..."
        )
        start = time.monotonic()
        next_t = start
        try:
            for seq in range(1, count + 1):
                now = time.monotonic()
                if next_t > now:
                    time.sleep(next_t - now)
                # monotonic, not wall clock: only send/receive *differences*
                # feed the jitter calculation, so the two clocks need no
                # relationship — but an NTP step mid-run would show up as a
                # false jitter spike if this were time.time().
                datagram = encode_probe(seq, time.monotonic(), size)
                sock.sendto(datagram, (group, port))
                sent += 1
                sent_bytes += len(datagram)
                next_t += 1.0 / rate
        except KeyboardInterrupt:
            interrupted = True
        elapsed = max(time.monotonic() - start, 0.001)
    except OSError as exc:
        print(f"error: {exc} (no route to {group}, or interface down)", file=sys.stderr)
        return EXIT_ERROR
    finally:
        sock.close()

    report.header("mcastcheck")
    print(f"mode: send  group: {group}:{port}  iface: {iface_label}  ttl: {ttl}")
    report.section("sent")
    print(
        f"  {sent}/{count} probes ({sent_bytes} bytes) in {elapsed:.1f}s "
        f"({sent / elapsed:.1f}/s)"
    )
    # An interrupted run still sent real probes, so it still has to produce its
    # assessment and its evidence file — Ctrl-C is how a pair test normally ends
    # once the receiving side has seen enough.
    if interrupted:
        code = EXIT_INTERRUPT
        report.warning(f"interrupted after {sent} of {count} probes")
        report.verdict(
            f"{sent} of {count} probe(s) sent before the run was interrupted.",
            "Loss at the receiver will count the probes never sent; compare "
            "against this sent count, or re-run to completion for a clean figure.",
        )
    else:
        code = EXIT_OK
        report.verdict(
            f"{sent} probe(s) sent to {group}:{port}.",
            "Read loss and jitter on the receiving side (mcastcheck recv).",
        )

    if dump:
        payload = {
            "tool": "mcastcheck",
            "mode": "send",
            "group": group,
            "port": port,
            "sent": sent,
            "count": count,
            "bytes": sent_bytes,
            "rate_pps": rate,
            "ttl": ttl,
            "interrupted": interrupted,
            "assessment_code": code,
        }
        path = report.write_dump(dump, payload)
        print(f"dump: {path}")

    report.finished()
    return code


def main(argv: list[str] | None = None) -> int:
    parser = cli.ArgumentParser(prog="mcastcheck", add_help=False)
    parser.add_argument("mode", nargs="?", default="recv")
    parser.add_argument("-g", "--group", default=DEFAULT_GROUP)
    parser.add_argument("-p", "--port", type=int, default=DEFAULT_PORT)
    parser.add_argument("-i", "--iface")
    # Mode-specific options carry no defaults so an unsupplied one reads as
    # None; MODE_OPTIONS below turns "supplied for the wrong mode" into an error
    # instead of a silent no-op. Defaults are applied after the mode is known.
    parser.add_argument("-t", "--timeout", type=float)
    parser.add_argument("-c", "--count", type=int)
    parser.add_argument("-r", "--rate", type=int)
    parser.add_argument("-s", "--size", type=int)
    parser.add_argument("-T", "--ttl", type=int)
    parser.add_argument("-y", "--yes", action="store_true")
    parser.add_argument("--dump")
    parser.add_argument("-h", "--help", action="store_true")
    args = parser.parse_args(argv)

    if args.help:
        print(_usage(), end="")
        return EXIT_OK

    if args.mode not in ("recv", "send"):
        print(f"error: unknown mode: {args.mode} (use recv or send)", file=sys.stderr)
        return EXIT_ERROR

    foreign = cli.foreign_options(args.mode, vars(args), MODE_OPTIONS)
    if foreign:
        if len(foreign) > 1:
            phrase = f"{', '.join(foreign)} options do not apply"
        else:
            phrase = f"{foreign[0]} option does not apply"
        print(f"error: {phrase} to '{args.mode}' mode", file=sys.stderr)
        print("hint: mcastcheck --help", file=sys.stderr)
        return EXIT_ERROR

    if args.timeout is None:
        args.timeout = DEFAULT_TIMEOUT
    if args.count is None:
        args.count = DEFAULT_COUNT
    if args.rate is None:
        args.rate = DEFAULT_RATE
    if args.size is None:
        args.size = DEFAULT_SIZE
    if args.ttl is None:
        args.ttl = DEFAULT_TTL

    try:
        if not ipaddress.IPv4Address(args.group).is_multicast:
            raise ValueError
    except ValueError:
        print(f"error: not an IPv4 multicast group: {args.group}", file=sys.stderr)
        return EXIT_ERROR
    if not 1 <= args.port <= 65535:
        print("error: port must be 1-65535", file=sys.stderr)
        return EXIT_ERROR
    if args.timeout <= 0:
        print("error: timeout must be positive", file=sys.stderr)
        return EXIT_ERROR
    if not 1 <= args.count <= 1000000:
        print("error: count must be 1-1000000", file=sys.stderr)
        return EXIT_ERROR
    if not 1 <= args.rate <= 5000:
        print("error: rate must be 1-5000 probes/s", file=sys.stderr)
        return EXIT_ERROR
    if not HEADER_LEN <= args.size <= 1472:
        print(f"error: size must be {HEADER_LEN}-1472 bytes", file=sys.stderr)
        return EXIT_ERROR
    if not 1 <= args.ttl <= 255:
        print("error: ttl must be 1-255", file=sys.stderr)
        return EXIT_ERROR

    # Transmitting into a group that is carrying live audio disrupts a running
    # show, so the documented "do not send here" rule is enforced rather than
    # trusted. recv is unaffected: joining is what the tool is for.
    if args.mode == "send" and in_live_media_range(args.group) and not args.yes:
        print(
            f"error: {args.group} is inside {LIVE_MEDIA_RANGE}, the range Dante "
            "uses for media flows by default",
            file=sys.stderr,
        )
        print(
            "hint: sending probes to a group carrying live audio/video will "
            "disrupt it. Use 'mcastcheck recv' to observe the flow instead, or "
            "pass -y if you have confirmed this group is unused.",
            file=sys.stderr,
        )
        return EXIT_ERROR

    iface_ip: str | None = None
    iface_label = "(default route)"
    if args.iface:
        try:
            iface = resolve_iface(args.iface)
        except NetError as exc:
            print(f"error: {exc}", file=sys.stderr)
            return EXIT_ERROR
        iface_ip = iface_ipv4(iface)
        if not iface_ip:
            print(f"error: no IPv4 address on {iface}", file=sys.stderr)
            return EXIT_ERROR
        iface_label = f"{iface} ({iface_ip})"

    if args.mode == "recv":
        return run_recv(
            args.group, args.port, iface_label, iface_ip, args.timeout, args.dump
        )
    return run_send(
        args.group,
        args.port,
        iface_label,
        iface_ip,
        args.count,
        args.rate,
        args.size,
        args.ttl,
        args.dump,
    )


if __name__ == "__main__":
    sys.exit(main())
