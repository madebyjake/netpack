#!/usr/bin/env bash
# path3 — compare mtr over ICMP, UDP, and TCP
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/netpack.sh
source "${ROOT}/lib/netpack.sh"
# shellcheck source=../lib/netpack/parsers.sh
source "${ROOT}/lib/netpack/parsers.sh"

COUNT=50
PORT=443
TARGET=""
IFACE=""

usage() {
  cat <<'EOF'
path3 — run mtr against a target in ICMP, UDP, and TCP modes.

Compares final-hop loss across protocols. Probe volume is COUNT x 3 modes.
The UDP mode sweeps destination ports and the TCP mode sends repeated SYNs,
which firewalls and IDS may flag as a port scan; probe only networks you are
authorized to test.
Tries unprivileged first; if a mode fails (common without CAP_NET_RAW on
UDP/TCP), re-run with sudo.

On a multi-homed machine, -i binds the probes to IFACE's address so a chosen
uplink's path is traced instead of the default route's. The target is off-link,
so the run needs a policy route (ip rule) steering that address out IFACE;
without one it exits 1 rather than tracing a path the probes did not take.

Usage:
  path3 [-i IFACE] [-c COUNT] [-p TCP_PORT] TARGET

Options:
  -i IFACE      Bind probes to IFACE's address (multi-homed)
  -c COUNT      Probes per mode (default: 50)
  -p TCP_PORT   TCP destination port (default: 443)
  -h, --help    Show this help

Notes:
  Prefer loss that appears at the final hop and is consistent across protocols.
  Intermediate-only loss is often control-plane deprioritization, not forwarding loss.
  Final-hop loss on every protocol is forwarding loss; loss on only some is
  usually per-protocol policing or rate limiting of that probe type.

Exit codes:
  0  all modes produced usable reports, no final-hop loss above 1%
  1  usage, dependency, permission, or mode failure; or -i could not bind
  2  final-hop loss above 1% on every measured protocol
  3  final-hop loss above 1% on some protocols but not others
  130  interrupted; only the modes that completed were measured

Ctrl-C stops the run and still reports. A mode cut short or never started shows
as "-" and is not counted as a failed mode.
EOF
}

if [[ "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

while getopts ":i:c:p:h" opt; do
  case "$opt" in
    i) IFACE=$OPTARG ;;
    c) COUNT=$OPTARG ;;
    p) PORT=$OPTARG ;;
    h) usage; exit 0 ;;
    *) usage >&2; exit 1 ;;
  esac
done
shift $((OPTIND - 1))

TARGET=${1:-}
[[ -n "$TARGET" ]] || { usage >&2; exit 1; }
shift
no_extra_args "$@"
require_uint count "$COUNT" 1
require_uint port "$PORT" 1 65535
require_cmd mtr awk

MTR_BIND=()
if [[ -n "$IFACE" ]]; then
  SRC="$(require_uplink "$IFACE" "$TARGET")"
  MTR_BIND=(-a "$SRC")
  VIA=$IFACE
else
  VIA="$(via_for "$TARGET")"
fi

header path3
echo "target: ${TARGET}  count: ${COUNT}  tcp_port: ${PORT}${VIA:+  via: ${VIA}}"
if [[ -n "$IFACE" ]]; then
  multihomed_note "${IFACE} (bound with -i)"
else
  multihomed_note "$VIA" "pass -i IFACE to trace another uplink"
fi
echo

DIR="$(private_tmpdir path3)"
cleanup() { rm -rf "$DIR"; }
trap cleanup EXIT

FAILED_MODES=0

run_mode() {
  local label=$1
  shift
  local out="${DIR}/${label}.txt"
  local pid rc=0 t0=$SECONDS
  # A mode the run never started is unmeasured. Skipping it here rather than
  # letting mtr run means the summary reports "-" for it, which reads as no
  # data, instead of a loss figure for probes that were never sent.
  if interrupted; then
    echo "=== ${label} (skipped — run interrupted) ==="
    echo
    return 0
  fi
  echo "=== ${label} (${COUNT} probes) ==="
  # mtr -r prints nothing until it finishes, so run it in the background and
  # tick elapsed time on stderr; the report itself loses nothing.
  mtr -rwb "${MTR_BIND[@]+"${MTR_BIND[@]}"}" -c "$COUNT" "$@" "$TARGET" >"$out" &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    pulse "${label}: $((SECONDS - t0))s of ~${COUNT}s"
    sleep 1
  done
  wait "$pid" || rc=$?
  # SC2119: pulse_done's argument is an optional final message, not wanted here.
  # shellcheck disable=SC2119
  pulse_done
  cat "$out"
  # Ctrl-C kills mtr too, so it exits non-zero and writes no summary. That is
  # the interrupt, not a broken mode — counting it would raise the "mtr mode(s)
  # failed, re-run with sudo" verdict against a run the operator ended.
  if interrupted; then
    warning "${label} interrupted before its probes completed"
    echo
    return 0
  fi
  if (( rc != 0 )); then
    echo "error: mtr ${label} exited non-zero" >&2
    FAILED_MODES=$((FAILED_MODES + 1))
  elif [[ ! -s "$out" ]]; then
    echo "error: mtr ${label} produced no output" >&2
    FAILED_MODES=$((FAILED_MODES + 1))
  elif ! grep -q '%' "$out"; then
    echo "error: mtr ${label} output missing loss columns (unusable report)" >&2
    FAILED_MODES=$((FAILED_MODES + 1))
  fi
  echo
}

catch_int
run_mode icmp
run_mode udp -u
run_mode tcp -T -P "$PORT"
release_int

echo "=== final-hop summary ==="
printf '%-5s %-40s %-10s %s\n' "mode" "host" "loss" "avg"
FINAL_LOSS=()
for m in icmp udp tcp; do
  f="${DIR}/${m}.txt"
  if [[ ! -s "$f" ]]; then
    printf '%-5s %-40s %-10s %s\n' "$m" "-" "$(color_status bad "-")" "-"
    FINAL_LOSS+=("-")
    continue
  fi
  IFS=$'\t' read -r host loss avg <<<"$(summarize_final "$f")"
  loss_disp="${loss:--}"
  loss_num="-"
  if [[ "$loss_disp" != "-" ]]; then
    # summarize_final returns e.g. 4.0%; strip % for threshold helper.
    loss_num="${loss_disp%%%}"
    loss_disp="$(color_loss_pct "$loss_num")"
  fi
  FINAL_LOSS+=("$loss_num")
  printf '%-5s %-40s %-10s %s\n' "$m" "${host:--}" "$loss_disp" "${avg:--}"
done

if interrupted; then
  note "interrupted — modes shown as '-' were cut short or never started"
fi

if (( FAILED_MODES > 0 )); then
  if [[ "$(id -u)" -ne 0 ]]; then
    verdict "${FAILED_MODES} mtr mode(s) failed." \
      "Re-run with sudo (CAP_NET_RAW may be required)."
  else
    verdict "${FAILED_MODES} mtr mode(s) failed or produced unusable output."
  fi
  finish_with 1
fi

# Every mode was cut short or skipped, so there is no loss figure to classify.
if interrupted && [[ "$(printf '%s\n' "${FINAL_LOSS[@]}" | tr -d '-\n')" == "" ]]; then
  verdict "interrupted before any mode produced a usable report; no path evidence collected." \
    "Re-run and allow at least one mode to complete."
  finish_with 130
fi
# The report is evidence either way; the exit code says whether it found loss,
# so a scripted run can tell "the path is clean" from "the path is not".
case "$(classify_loss_set 1 "${FINAL_LOSS[@]}")" in
  all)
    verdict "final-hop loss on every measured protocol." \
      "Consistent across protocols points at forwarding loss on the path, not probe deprioritization."
    finish_with 2
    ;;
  mixed)
    verdict "final-hop loss on some protocols but not others." \
      "Per-protocol loss is usually policing or rate limiting of that probe type; compare the modes above before blaming the path."
    finish_with 3
    ;;
  *)
    verdict "all three modes produced usable reports; no final-hop loss above 1%." \
      "Intermediate-only loss in the hop lists is often control-plane deprioritization, not forwarding loss."
    finish_with 0
    ;;
esac
