#!/usr/bin/env bash
# testsrv — iperf3 server with lifetime-limited nftables set membership
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/netpack.sh
source "${ROOT}/lib/netpack.sh"

PORT=5201
NFT_OPENED=0
NO_FW=0

usage() {
  cat <<'EOF'
testsrv — run an iperf3 server for a planned throughput/loss test.

Generates significant traffic once clients connect. Use only during planned tests.

If nftables sets inet filter test_tcp and test_udp exist, the chosen port is
added for the lifetime of this process and removed on EXIT/INT/TERM. A SIGKILL
or abrupt power loss will not run cleanup; remove the port manually if needed:
  sudo nft delete element inet filter test_tcp "{ PORT }"
  sudo nft delete element inet filter test_udp "{ PORT }"

If the sets are absent, no firewall changes are made. -n skips firewall
handling entirely — iperf3 itself needs no root, so a non-root run with -n
works anywhere the port is already reachable.

Usage:
  testsrv [-p PORT] [-n]

Options:
  -p PORT       Listen port (default: 5201)
  -n            Do not touch nftables sets (no root needed)
  -h, --help    Show this help

Client examples:
  testcli <host>
  testcli -u -b 5M <host>
  # or: iperf3 -c <host> -p 5201 -t 30

Exit codes:
  0  server stopped normally (Ctrl-C is the normal stop)
  1  usage, dependency, or firewall error; iperf3 failed to run
EOF
}

if [[ "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

while getopts ":p:nh" opt; do
  case "$opt" in
    p) PORT=$OPTARG ;;
    n) NO_FW=1 ;;
    h) usage; exit 0 ;;
    *) usage >&2; exit 1 ;;
  esac
done
shift $((OPTIND - 1))
no_extra_args "$@"

require_uint port "$PORT" 1 65535
require_cmd iperf3

nft_sets_present() {
  # Caller must be root when nft is installed; otherwise list failures look
  # identical to missing sets.
  nft list set inet filter test_tcp >/dev/null 2>&1 \
    && nft list set inet filter test_udp >/dev/null 2>&1
}

open_port() {
  if [[ "$NO_FW" -eq 1 ]]; then
    echo "firewall: untouched (-n)"
    return 0
  fi
  if ! command -v nft >/dev/null 2>&1; then
    warning "nft not found; firewall unchanged" >&2
    return 0
  fi
  if [[ "$(id -u)" -ne 0 ]]; then
    die "cannot verify nft sets without root; re-run with sudo, or pass -n to skip firewall handling"
  fi
  if ! nft_sets_present; then
    warning "nft sets inet filter test_tcp/test_udp not found; firewall unchanged" >&2
    return 0
  fi
  if ! nft add element inet filter test_tcp "{ ${PORT} }"; then
    die "failed to add port ${PORT} to inet filter test_tcp"
  fi
  if ! nft add element inet filter test_udp "{ ${PORT} }"; then
    nft delete element inet filter test_tcp "{ ${PORT} }" 2>/dev/null || true
    die "failed to add port ${PORT} to inet filter test_udp"
  fi
  NFT_OPENED=1
  echo "firewall: port ${PORT} added to test_tcp/test_udp for process lifetime"
}

close_port() {
  if [[ "$NFT_OPENED" -eq 1 ]]; then
    NFT_OPENED=0  # trap fires on both INT and EXIT; clean up once
    nft delete element inet filter test_tcp "{ ${PORT} }" 2>/dev/null || true
    nft delete element inet filter test_udp "{ ${PORT} }" 2>/dev/null || true
    echo
    echo "firewall: port ${PORT} removed from test_tcp/test_udp"
  fi
}

trap close_port EXIT INT TERM

open_port
header testsrv
echo "iperf3 listening on port ${PORT} (Ctrl-C to stop)"
# Ctrl-C is the normal stop for a server; the report still has to close so the
# evidence carries its own end time.
INTERRUPTED=0
trap 'INTERRUPTED=1' INT
RC=0
iperf3 -s -p "$PORT" || RC=$?
if (( INTERRUPTED )) || (( RC == 130 )); then
  RC=0
fi

if (( RC != 0 )); then
  verdict "iperf3 exited ${RC}." \
    "Check that port ${PORT} is free and reachable from the client."
  finished
  exit 1
fi
verdict "iperf3 server on port ${PORT} stopped."
finished
