#!/usr/bin/env python3
"""discover — enumerate devices advertising services via SSDP and mDNS."""

from __future__ import annotations

import socket
import struct
import sys
import time
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))

from netpack import cli, report, services
from netpack.discovery import encode_name, parse_mdns, parse_ssdp
from netpack.net import NetError, iface_ipv4, resolve_iface

EXIT_OK = 0
EXIT_ERROR = 1
EXIT_INTERRUPT = 130

SSDP_ADDR = ("239.255.255.250", 1900)
MDNS_ADDR = ("224.0.0.251", 5353)
MDNS_META = "_services._dns-sd._udp.local"


def _usage() -> str:
    return """\
discover — list devices that announce services on the local segment.

Sends an SSDP M-SEARCH and an mDNS service-enumeration query, then groups the
replies by host. Complements segscan: ARP tells you which addresses are live;
discover tells you what they claim to be (media servers, TVs, printers,
cameras, AV gear). IPv4 link-local multicast only; no root required.

Queries leave via the default-route interface unless -i pins them to another —
on a multi-homed machine the segment under test is often not the default route.

mDNS replies are requested as unicast (QU); responders that only multicast are
not captured. Best-effort, not exhaustive.

Known service types are annotated with a plain-language label; anything not
recognized is printed verbatim, so nothing discovered is hidden. Hosts
advertising real-time AV transports (Dante, NDI) are also listed on their own,
since those flows depend on clocking, QoS and multicast handling.

Usage:
  discover [-i IFACE] [-t SECONDS] [--dump FILE]

Options:
  -i, --iface IFACE   Interface to query from (default: default-route iface)
  -t, --timeout SEC   Listen window per protocol (default: 3)
  --dump FILE         Write JSON evidence to FILE
  -h, --help          Show this help

Exit codes:
  0  discovery completed (zero devices is a valid result)
  1  usage, dependency, or socket error
  130  interrupted before the listen windows completed
"""


def _outbound_ip() -> str | None:
    """Source IP of the default route, for pinning multicast to that interface."""
    try:
        probe = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        try:
            probe.connect(("1.1.1.1", 53))
            return probe.getsockname()[0]
        finally:
            probe.close()
    except OSError:
        return None


def _mcast_socket(ttl: int, src_ip: str | None) -> socket.socket:
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    sock.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, ttl)
    if src_ip:
        try:
            sock.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_IF, socket.inet_aton(src_ip))
        except OSError:
            pass
    sock.settimeout(0.5)
    return sock


def ssdp_search(timeout: float, src_ip: str | None) -> tuple[dict[str, dict[str, Any]], str]:
    msg = (
        b"M-SEARCH * HTTP/1.1\r\n"
        b"HOST: 239.255.255.250:1900\r\n"
        b'MAN: "ssdp:discover"\r\n'
        b"MX: 2\r\n"
        b"ST: ssdp:all\r\n\r\n"
    )
    sock = _mcast_socket(2, src_ip)
    devices: dict[str, dict[str, Any]] = {}
    try:
        try:
            sock.sendto(msg, SSDP_ADDR)
        except OSError as exc:
            return devices, str(exc)
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            try:
                data, addr = sock.recvfrom(65535)
            except TimeoutError:
                continue
            ip = addr[0]
            headers = parse_ssdp(data)
            dev = devices.setdefault(ip, {"ip": ip, "server": "", "services": set()})
            if headers.get("server"):
                dev["server"] = headers["server"]
            st = headers.get("st") or headers.get("nt")
            if st and st != "ssdp:all":
                dev["services"].add(st)
    finally:
        sock.close()
    return devices, ""


def mdns_search(timeout: float, src_ip: str | None) -> tuple[dict[str, set[str]], str]:
    header = struct.pack(">HHHHHH", 0, 0, 1, 0, 0, 0)
    # qclass 0x8001 = IN with the unicast-response (QU) bit set.
    query = header + encode_name(MDNS_META) + struct.pack(">HH", 12, 0x8001)
    sock = _mcast_socket(1, src_ip)
    hosts: dict[str, set[str]] = {}
    try:
        try:
            sock.sendto(query, MDNS_ADDR)
        except OSError as exc:
            return hosts, str(exc)
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            try:
                data, addr = sock.recvfrom(65535)
            except TimeoutError:
                continue
            ip = addr[0]
            for rtype, _name, target in parse_mdns(data):
                if rtype == 12 and target:  # PTR → advertised service type
                    hosts.setdefault(ip, set()).add(target.replace(".local", ""))
    finally:
        sock.close()
    return hosts, ""


def print_report(
    ssdp: dict[str, dict[str, Any]],
    mdns: dict[str, set[str]],
    timeout: float,
    iface_label: str,
    ssdp_err: str = "",
    mdns_err: str = "",
) -> None:
    report.header("discover")
    print(f"window: {timeout:g}s per protocol  iface: {iface_label}")

    report.section(f"SSDP ({len(ssdp)})")
    if ssdp_err:
        report.warning(f"SSDP query failed: {ssdp_err}")
    if not ssdp:
        print("  (none)")
    for ip in sorted(ssdp, key=_ip_key):
        dev = ssdp[ip]
        server = dev["server"][:60] or "-"
        print(f"  {ip}  {server}")
        svcs = sorted(dev["services"])
        if svcs:
            print(f"      services: {len(svcs)} ({', '.join(svcs[:4])}"
                  f"{', …' if len(svcs) > 4 else ''})")

    report.section(f"mDNS ({len(mdns)})")
    if mdns_err:
        report.warning(f"mDNS query failed: {mdns_err}")
    if not mdns:
        print("  (none)")
    media_hosts: dict[str, list[str]] = {}
    for ip in sorted(mdns, key=_ip_key):
        svcs = sorted(mdns[ip])
        labelled = [services.describe_service(s) for s in svcs]
        print(f"  {ip}  {', '.join(labelled) if labelled else '-'}")
        found = services.media_services(svcs)
        if found:
            media_hosts[ip] = found

    if media_hosts:
        report.section(f"real-time media advertisers ({len(media_hosts)})")
        for ip, svcs in media_hosts.items():
            print(f"  {ip}  {', '.join(services.describe_service(s) for s in svcs)}")
        report.note(
            "Dante/NDI transports are sensitive to clocking, QoS marking and "
            "multicast handling. If these devices misbehave, follow up with "
            "linkstat (EEE, errors), mcastcheck (group delivery) and splitloss "
            "(loss under load) at the affected drop."
        )

    total = len(set(ssdp) | set(mdns))
    if total == 0:
        report.verdict(
            "no SSDP or mDNS responders seen.",
            "Quiet segment, discovery filtered by client isolation, or nothing advertising.",
        )
    else:
        report.verdict(
            f"{total} host(s) announced services (SSDP {len(ssdp)}, mDNS {len(mdns)}).",
            "Cross-reference with segscan; unexpected advertisers may be rogue devices.",
        )


def _ip_key(ip: str) -> tuple:
    try:
        return tuple(int(p) for p in ip.split("."))
    except ValueError:
        return (0,)


def main(argv: list[str] | None = None) -> int:
    parser = cli.ArgumentParser(prog="discover", add_help=False)
    parser.add_argument("-i", "--iface")
    parser.add_argument("-t", "--timeout", type=float, default=3.0)
    parser.add_argument("--dump")
    parser.add_argument("-h", "--help", action="store_true")
    args = parser.parse_args(argv)

    if args.help:
        print(_usage(), end="")
        return EXIT_OK

    if args.timeout <= 0:
        print("error: timeout must be positive", file=sys.stderr)
        return EXIT_ERROR

    if args.iface:
        try:
            iface = resolve_iface(args.iface)
        except NetError as exc:
            print(f"error: {exc}", file=sys.stderr)
            return EXIT_ERROR
        src_ip = iface_ipv4(iface)
        if not src_ip:
            print(f"error: no IPv4 address on {iface}", file=sys.stderr)
            return EXIT_ERROR
        iface_label = f"{iface} ({src_ip})"
    else:
        src_ip = _outbound_ip()
        iface_label = "(default route)"
    try:
        ssdp, ssdp_err = ssdp_search(args.timeout, src_ip)
        mdns, mdns_err = mdns_search(args.timeout, src_ip)
    except KeyboardInterrupt:
        print("error: interrupted", file=sys.stderr)
        return EXIT_INTERRUPT

    if ssdp_err and mdns_err:
        print(
            f"error: could not send discovery queries ({ssdp_err}); "
            "no multicast route, or interface down",
            file=sys.stderr,
        )
        return EXIT_ERROR

    print_report(ssdp, mdns, args.timeout, iface_label, ssdp_err, mdns_err)

    # Zero responders is a valid result, not a condition. Held in a variable so
    # the dump records the returned code rather than re-deriving it.
    code = EXIT_OK

    if args.dump:
        payload = {
            "tool": "discover",
            "timeout_s": args.timeout,
            "iface": iface_label,
            "ssdp": [
                {"ip": d["ip"], "server": d["server"], "services": sorted(d["services"])}
                for d in ssdp.values()
            ],
            "mdns": [
                {
                    "ip": ip,
                    "services": sorted(s),
                    "labels": {
                        svc: services.label_service(svc)
                        for svc in sorted(s)
                        if services.label_service(svc)
                    },
                }
                for ip, s in mdns.items()
            ],
            "host_count": len(set(ssdp) | set(mdns)),
            "assessment_code": code,
        }
        path = report.write_dump(args.dump, payload)
        print(f"dump: {path}")

    report.finished()
    return code


if __name__ == "__main__":
    sys.exit(main())
