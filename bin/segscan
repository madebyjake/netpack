#!/usr/bin/env bash
# segscan — segment inventory for an unfamiliar link
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/netpack.sh
source "${ROOT}/lib/netpack.sh"
# shellcheck source=../lib/netpack/parsers.sh
source "${ROOT}/lib/netpack/parsers.sh"

usage() {
  cat <<'EOF'
segscan — inventory the local segment (interface, LLDP, gateway, ARP).

Performs an active ARP sweep of the local subnet (arp-scan --localnet).
Requires root for arp-scan and typically for LLDP neighbor queries.

The sweep probes every address on the subnet and can read as recon to NAC or
switch port-security; run it only where you are authorized. Large prefixes also
generate substantial broadcast traffic — sweeps larger than /22 (1024
addresses) require -y to confirm. If the interface prefix cannot be read the
sweep cannot be sized, so it also requires -y rather than proceeding unchecked.

Usage:
  segscan [-i IFACE] [-y] [--dump FILE]

Options:
  -i IFACE      Interface (default: default-route iface)
  -y            Confirm ARP sweep on prefixes larger than /22
  --dump FILE   Write JSON evidence to FILE
  -h, --help    Show this help

Exit codes:
  0  inventory completed (sweep may be skipped if noted)
  1  usage, dependency, or refused sweep (too large, or size unknown)
  2  duplicate IP addresses detected
  130  interrupted; the sweep covers only the addresses it reached

Ctrl-C stops the sweep and still reports. Hosts that answered are real evidence,
but a partial sweep cannot rule duplicates out — only confirm them.
EOF
}

IFACE=""
CONFIRM_LARGE=0

if [[ "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

take_dump_opt "$@"
set -- "${NP_ARGS[@]+"${NP_ARGS[@]}"}"

while getopts ":i:yh" opt; do
  case "$opt" in
    i) IFACE=$OPTARG ;;
    y) CONFIRM_LARGE=1 ;;
    h) usage; exit 0 ;;
    *) usage >&2; exit 1 ;;
  esac
done
shift $((OPTIND - 1))
no_extra_args "$@"

IFACE="$(resolve_iface "${IFACE}")"
require_cmd ip

dump_begin
header segscan
echo "iface: ${IFACE}"
multihomed_note "$IFACE" "pass -i IFACE to inventory another segment"
echo
echo "=== interface ==="
ip -br addr show dev "$IFACE" || true

echo
echo "=== LLDP neighbor ==="
if command -v lldpcli >/dev/null 2>&1; then
  # details, not summary: lldpd's brief view returns after SysName, so MgmtIP
  # is never printed and the grep below could not match it — the address you
  # need to reach the switch was the one field missing. The grep keeps the
  # output as short as the summary was.
  if out="$(lldpcli show neighbors details 2>/dev/null)"; then
    filtered="$(printf '%s\n' "$out" | lldp_fields)"
    if [[ -n "$filtered" ]]; then
      printf '%s\n' "$filtered"
    else
      echo "  no LLDP neighbor seen (unmanaged device in path, or LLDP disabled)"
    fi
  else
    echo "  lldpcli query failed (root or lldpd may be required)"
  fi
else
  echo "  lldpd/lldpcli not installed"
fi

echo
echo "=== default gateway ==="
require_cmd ping
# IFACE's own default route, not the system default: on a multi-homed box the
# system default usually belongs to another uplink, and reporting it here would
# attribute another segment's gateway to this one.
GW="$(iface_gateway "$IFACE")"
if [[ -n "$GW" ]]; then
  echo "  gateway: ${GW}"
  ping -c1 -W1 "$GW" >/dev/null 2>&1 || true
  ip neigh show "$GW" dev "$IFACE" 2>/dev/null || true
else
  SYS_GW="$(default_gateway)"
  if [[ -n "$SYS_GW" ]]; then
    echo "  no default route on ${IFACE} (system default ${SYS_GW} is on another interface)"
  else
    echo "  no default gateway"
  fi
fi

echo
echo "=== ARP sweep ==="
SWEEP_DIR="$(private_tmpdir segscan)"
SWEEP="${SWEEP_DIR}/arp.txt"
cleanup() { rm -rf "$SWEEP_DIR"; }
trap cleanup EXIT

# SWEEP_STATE distinguishes the four ways the sweep can end. Without it a host
# list of zero is ambiguous: an empty segment, a missing arp-scan, a non-root
# run and an interrupted sweep all produce no rows.
SWEEP_STATE=completed

emit_dump() {
  local code=$1
  [[ -n "$DUMP_PATH" ]] || return 0
  dump_str iface "$IFACE"
  dump_opt_str gateway "${GW:-}"
  dump_num prefixlen "${PREFIX:-}"
  dump_str sweep_state "$SWEEP_STATE"
  dump_bool interrupted "$(interrupted && echo true || echo false)"
  dump_write "$DUMP_PATH" segscan "$code" || true
}

iface_prefixlen() {
  ip -o -4 addr show dev "$IFACE" 2>/dev/null \
    | awk '{
        for (i = 1; i <= NF; i++) {
          if ($i == "inet") {
            split($(i + 1), a, "/")
            if (a[2] != "") { print a[2]; exit }
          }
        }
      }'
}

PREFIX="$(iface_prefixlen || true)"
case "$(classify_sweep "$PREFIX" 22)" in
  large)
    # Address count is 2^(32-prefix), including the network and broadcast ends.
    HOSTS=$((1 << (32 - 10#$PREFIX)))
    echo "  interface prefix /${PREFIX} (~${HOSTS} addresses)"
    if [[ "$CONFIRM_LARGE" -ne 1 ]]; then
      die "ARP sweep of /${PREFIX} may disrupt a live segment; re-run with -y to confirm"
    fi
    echo "  large sweep confirmed with -y"
    ;;
  unsized)
    echo "  $(color_status warn "interface prefix unknown; sweep size cannot be checked")"
    if [[ "$CONFIRM_LARGE" -ne 1 ]]; then
      die "cannot determine the subnet size on ${IFACE}; re-run with -y to confirm the sweep"
    fi
    echo "  unsized sweep confirmed with -y"
    ;;
esac

if ! command -v arp-scan >/dev/null 2>&1; then
  echo "  $(color_status warn "arp-scan not installed")"
  echo
  echo "=== duplicate IPs ==="
  echo "  $(color_status warn "skipped (no sweep data)")"
  verdict "ARP sweep skipped (arp-scan not installed)." \
    "Install arp-scan and re-run for duplicate-IP detection."
  SWEEP_STATE=skipped_no_arp_scan
  emit_dump 0
  finish_with 0
fi

if [[ "$(id -u)" -ne 0 ]]; then
  echo "  $(color_status warn "arp-scan requires root; re-run with sudo for the sweep")"
  echo
  echo "=== duplicate IPs ==="
  echo "  $(color_status warn "skipped (no sweep data)")"
  verdict "ARP sweep skipped (root required)." \
    "Re-run with sudo for the sweep and duplicate-IP check."
  SWEEP_STATE=skipped_no_root
  emit_dump 0
  finish_with 0
fi

# tee keeps whatever the sweep reached before Ctrl-C: a host that answered ARP
# is on the segment regardless of when the sweep stopped. What a partial sweep
# cannot support is the negative — see the verdict below.
catch_int
arp-scan --interface="$IFACE" --localnet --retry=2 2>/dev/null \
  | tee "$SWEEP" \
  | tail -n +3 || true
release_int

echo
echo "=== duplicate IPs ==="
DUP_EXIT=0
if [[ -s "$SWEEP" ]]; then
  dups="$(arp_duplicates "$SWEEP" || true)"
  if [[ -z "$dups" ]]; then
    echo "  $(color_status ok none)"
  else
    while IFS= read -r ip; do
      [[ -n "$ip" ]] || continue
      echo "  $(color_status bad "DUPLICATE: ${ip}")"
      grep -E "^${ip}[[:space:]]" "$SWEEP" | sed 's/^/    /' || true
      DUP_EXIT=2
    done <<<"$dups"
  fi
else
  echo "  $(color_status warn "skipped (no sweep data)")"
fi

if interrupted; then
  SWEEP_STATE=partial
  note "interrupted — the sweep covers only the addresses reached before it stopped"
fi

# One row per responding host. arp-scan prints "IP<TAB>MAC<TAB>vendor" between
# banner and footer lines, so rows are selected by a leading IPv4 literal rather
# than by line number.
if [[ -n "$DUMP_PATH" && -s "$SWEEP" ]]; then
  while IFS=$'\t' read -r ip mac vendor; do
    [[ -n "$ip" ]] || continue
    dump_row hosts "s:ip=${ip}" "s:mac=${mac}" "S:vendor=${vendor}"
  done < <(awk -F'\t' '$1 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ { print }' "$SWEEP")
  # Duplicates are listed separately as well as being derivable from hosts: it
  # is the finding, and a consumer should not have to re-implement the grouping
  # to notice two MACs claiming one address.
  if [[ -n "${dups:-}" ]]; then
    while IFS= read -r dip; do
      [[ -n "$dip" ]] || continue
      dump_row duplicate_ips "s:ip=${dip}"
    done <<<"$dups"
  fi
fi

if (( DUP_EXIT == 2 )); then
  # A duplicate is a positive finding: the two MACs really did both answer, so
  # a partial sweep proves it just as well as a complete one.
  verdict "duplicate IP addresses detected on the segment." \
    "Inspect conflicting MACs above and isolate the unexpected host."
elif [[ -s "$SWEEP" ]] && interrupted; then
  # The negative is what a partial sweep cannot support: the duplicate may sit
  # in the part of the subnet the sweep never reached.
  verdict "no duplicate IPs among the addresses swept before the run was interrupted." \
    "The rest of the subnet was not swept; re-run to completion to rule out duplicates."
elif [[ -s "$SWEEP" ]]; then
  verdict "segment inventory complete; no duplicate IPs in the sweep."
elif interrupted; then
  verdict "interrupted before the ARP sweep returned any data." \
    "Re-run and allow the sweep to complete."
else
  verdict "segment inventory complete; ARP sweep produced no data." \
    "Check interface state and that arp-scan can reach the segment."
fi
emit_dump "$(interrupted && echo 130 || echo "$DUP_EXIT")"
finish_with "$DUP_EXIT"
