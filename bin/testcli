#!/usr/bin/env bash
# testcli — iperf3 client companion to testsrv
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/netpack.sh
source "${ROOT}/lib/netpack.sh"
# shellcheck source=../lib/netpack/parsers.sh
source "${ROOT}/lib/netpack/parsers.sh"

PORT=5201
DURATION=30
UDP=0
BANDWIDTH="5M"
LENGTH=200
STREAMS=1
REVERSE=0
HOST=""

usage() {
  cat <<'EOF'
testcli — iperf3 client for planned throughput/loss tests against testsrv.

Generates significant traffic. Use only during planned tests on live networks.

Typical pair:
  On the far end:   sudo testsrv -p 5201
  On this machine:  testcli <server-ip>
                    testcli -u -b 5M <server-ip>

UDP mode uses a controlled rate suitable for game-like loss checks. The UDP
report Lost/Total is one-way loss on the path under test.

-R reverses direction (the server sends): run once without and once with -R
to evidence both directions without swapping machines. A single TCP stream
often cannot fill a high-rate path; use -P to run parallel streams (WAN
throughput proof against a cloud iperf3 host typically needs -P 4 or more).

Usage:
  testcli [-p PORT] [-t SECONDS] [-u] [-b BANDWIDTH] [-l LENGTH] [-P STREAMS]
          [-R] HOST

Options:
  -p PORT        Server port (default: 5201)
  -t SECONDS     Test duration (default: 30)
  -u             UDP mode (default: TCP)
  -b BANDWIDTH   UDP target bitrate (default: 5M); requires -u
  -l LENGTH      UDP payload length (default: 200); requires -u
  -P STREAMS     Parallel streams (default: 1)
  -R             Reverse: server sends (download-direction evidence)
  -h, --help     Show this help

Exit codes:
  0  iperf3 client completed successfully
  1  usage, dependency, or iperf3 error
  130  interrupted; the printed figures cover the completed portion only
EOF
}

if [[ "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

UDP_OPTS=()
while getopts ":p:t:ub:l:P:Rh" opt; do
  case "$opt" in
    p) PORT=$OPTARG ;;
    t) DURATION=$OPTARG ;;
    u) UDP=1 ;;
    b) BANDWIDTH=$OPTARG; UDP_OPTS+=(-b) ;;
    l) LENGTH=$OPTARG; UDP_OPTS+=(-l) ;;
    P) STREAMS=$OPTARG ;;
    R) REVERSE=1 ;;
    h) usage; exit 0 ;;
    *) usage >&2; exit 1 ;;
  esac
done
shift $((OPTIND - 1))

HOST=${1:-}
[[ -n "$HOST" ]] || { usage >&2; exit 1; }
shift
no_extra_args "$@"
require_uint port "$PORT" 1 65535
require_uint duration "$DURATION" 1
require_uint length "$LENGTH" 1
require_uint streams "$STREAMS" 1 128
# Normalize to base 10: bash arithmetic below would read a validated "08" as
# octal and abort the run with a raw arithmetic error.
STREAMS=$((10#$STREAMS))

# Reject UDP-only options in TCP mode rather than dropping them silently: a
# rate the operator believes they set, but that iperf3 never received, makes
# the resulting throughput evidence wrong in a way nothing on screen shows.
# Checked before the dependency probe so a bad invocation is reported as such
# even where iperf3 is missing.
if [[ "$UDP" -ne 1 && ${#UDP_OPTS[@]} -gt 0 ]]; then
  if (( ${#UDP_OPTS[@]} > 1 )); then
    die "${UDP_OPTS[*]} apply to UDP mode only; add -u"
  fi
  die "${UDP_OPTS[0]} applies to UDP mode only; add -u"
fi

require_cmd iperf3

EXTRA=()
DIRECTION="upload (client sends)"
if [[ "$REVERSE" -eq 1 ]]; then
  EXTRA+=(-R)
  DIRECTION="download (server sends)"
fi
if (( STREAMS > 1 )); then
  EXTRA+=(-P "$STREAMS")
fi

header testcli
VIA="$(via_for "$HOST")"
echo "host: ${HOST}  port: ${PORT}  duration: ${DURATION}s  direction: ${DIRECTION}${VIA:+  via: ${VIA}}"
multihomed_note "$VIA"
# Not exec: the run has to come back here to close the report, and to map
# iperf3's exit status onto the documented codes.
RC=0
if [[ "$UDP" -eq 1 ]]; then
  echo "mode: UDP  bandwidth ${BANDWIDTH}  length ${LENGTH}  streams ${STREAMS}"
  warning "generates significant traffic"
  iperf3 -c "$HOST" -p "$PORT" -u -b "$BANDWIDTH" -l "$LENGTH" \
    "${EXTRA[@]+"${EXTRA[@]}"}" -t "$DURATION" || RC=$?
else
  echo "mode: TCP  streams ${STREAMS}"
  warning "generates significant traffic"
  iperf3 -c "$HOST" -p "$PORT" "${EXTRA[@]+"${EXTRA[@]}"}" -t "$DURATION" || RC=$?
fi

if (( RC == 130 )); then
  verdict "run interrupted; the figures above cover the completed portion only." \
    "Re-run for a full window before treating the throughput as evidence."
  finished
  exit 130
fi
if (( RC != 0 )); then
  verdict "iperf3 exited ${RC}." \
    "Confirm testsrv is running on ${HOST}:${PORT} and the port is not filtered."
  finished
  exit 1
fi
verdict "iperf3 ${DIRECTION} run against ${HOST}:${PORT} completed."
finished
